#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

readonly MARKER="TILDE_PRIVILEGE_REQUIRED"
readonly PRIVILEGE_EXIT=125

abort() {
	warn "E: $*"
	exit 2
}

warn() {
	printf '%s\n' "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

canonical_path() {
	local path=$1

	local base
	local dir

	[[ -n $path ]] || return 1
	dir=${path%/*}
	base=${path##*/}
	[[ $dir != "$path" ]] || dir=.
	(
		cd -P -- "$dir" >/dev/null 2>&1 && printf '%s/%s\n' "$(pwd -P)" "$base"
	)
}

copy_clipboard() {
	local text=$1

	local tool

	while IFS= read -r tool; do
		command -v "$tool" >/dev/null 2>&1 || continue

		case ${tool##*/} in
		pbcopy | wl-copy | clip.exe)
			printf '%s' "$text" | "$tool" >/dev/null 2>&1 || continue
			;;
		xclip)
			printf '%s' "$text" | "$tool" -selection clipboard >/dev/null 2>&1 || continue
			;;
		xsel)
			printf '%s' "$text" | "$tool" --clipboard --input >/dev/null 2>&1 || continue
			;;
		*)
			continue
			;;
		esac

		printf '%s\n' "${tool##*/}"
		return
	done < <(clipboard_candidates)

	return 1
}

clipboard_candidates() {
	local os

	os=$(uname -s 2>/dev/null || printf unknown)

	case $os in
	Darwin)
		printf '%s\n' pbcopy
		;;
	Linux)
		printf '%s\n' wl-copy xclip xsel
		if [[ -r /proc/version ]] && grep -qi microsoft /proc/version; then
			printf '%s\n' clip.exe
		fi
		;;
	MINGW* | MSYS* | CYGWIN*)
		printf '%s\n' clip.exe
		;;
	esac
}

clipboard_tools() {
	local joined
	local tool

	local -a tools=()

	while IFS= read -r tool; do
		command -v "$tool" >/dev/null 2>&1 || continue
		tools+=("$tool")
	done < <(clipboard_candidates)

	((${#tools[@]} > 0)) || return 1
	joined=${tools[0]}
	for tool in "${tools[@]:1}"; do
		joined+=", $tool"
	done
	printf '%s\n' "$joined"
}

handoff_command() {
	local host=$1
	local root=$2

	local command
	local script

	if [[ $root == \~/.agents/skills/tilde ]]; then
		command=\~/.agents/skills/tilde/bin/sudo
		command+=' --handoff'
	else
		script=$(handoff_helper_script "$root")
		command="sh -c $(shell_quote "$script")"
	fi

	if [[ -n $host ]]; then
		printf 'ssh -t %s %s\n' "$(shell_word "$host")" "$(shell_quote "$command")"
	else
		printf '%s\n' "$command"
	fi
}

# shellcheck disable=SC2016
handoff_helper_check_script() {
	local root=$1

	handoff_root_script "$root"
	printf '[ -x "$r/bin/sudo" ] && grep -aq -- "--handoff" "$r/bin/sudo"'
}

# shellcheck disable=SC2016
handoff_helper_script() {
	local root=$1

	handoff_root_script "$root"
	printf 'exec "$r/bin/sudo" --handoff'
}

handoff_helper_supported() {
	local host=$1
	local root=$2

	if [[ -n $host ]]; then
		remote_handoff_helper_supported "$host" "$root"
	else
		local_handoff_helper_supported "$root"
	fi
}

handoff_root_path() {
	local root=$1

	case $root in
	\~)
		printf '%s\n' "$HOME"
		;;
	\~/*)
		printf '%s/%s\n' "$HOME" "${root#\~/}"
		;;
	/*)
		printf '%s\n' "$root"
		;;
	*)
		return 1
		;;
	esac
}

# shellcheck disable=SC2016
handoff_root_script() {
	local root=$1

	local root_word

	root_word=$(shell_double_quote "$root")
	printf 'r=%s; ' "$root_word"
	printf 'case $r in "~") r=$HOME;; "~/"*) r=$HOME/${r#\~/};; esac; '
}

# shellcheck disable=SC2016
handoff_script() {
	local root=$1

	handoff_root_script "$root"
	printf '[ -x "$r/bin/sudo" ] && grep -aq -- "--handoff" "$r/bin/sudo" && exec "$r/bin/sudo" --handoff; '
	printf '[ -x "$r/bin/tilde" ] && exec "$r/bin/tilde" sudo allow; '
	printf 'u=$(id -un) || exit 1; '
	printf 't=$(mktemp) || exit 1; '
	printf 'trap "rm -f \\"$t\\"" 0 1 2 3 15; '
	printf 'printf "%%s ALL=(ALL) NOPASSWD:ALL\\n" "$u" >"$t" || exit 1; '
	printf 'sudo visudo -cf "$t" >/dev/null && sudo install -m440 "$t" /etc/sudoers.d/tilde && sudo visudo -cf /etc/sudoers.d/tilde >/dev/null || { sudo rm -f /etc/sudoers.d/tilde; exit 1; }; '
	printf 'printf "OK: installed /etc/sudoers.d/tilde for %%s\\nCleanup: sudo rm -f /etc/sudoers.d/tilde\\n" "$u"'
}

emit_privilege() {
	local reason=$1
	local status=${2:-$PRIVILEGE_EXIT}

	local timestamp

	timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
	printf '%s reason=%s status=%s\n' "$MARKER" "$reason" "$status" >&2
	if [[ -n ${TILDE_SUDO_LOG:-} ]]; then
		printf '{"schema":"tilde.sudo/v1","event":"privilege_required","reason":"%s","status":%s,"timestamp":"%s"}\n' \
			"$reason" "$status" "$timestamp" >>"$TILDE_SUDO_LOG"
	fi
}

real_sudo() {
	local dir
	local IFS=:
	local sudo

	if [[ -n ${TILDE_REAL_SUDO:-} && -x ${TILDE_REAL_SUDO:-} ]] && ! tilde_sudo_shim "$TILDE_REAL_SUDO"; then
		printf '%s\n' "$TILDE_REAL_SUDO"
		return
	fi

	for dir in $PATH; do
		[[ -n $dir ]] || dir=.
		sudo=$dir/sudo
		[[ -x $sudo ]] || continue
		tilde_sudo_shim "$sudo" && continue
		printf '%s\n' "$sudo"
		return
	done

	for sudo in /usr/bin/sudo /bin/sudo /usr/local/bin/sudo; do
		[[ -x $sudo ]] || continue
		tilde_sudo_shim "$sudo" && continue
		printf '%s\n' "$sudo"
		return
	done

	return 1
}

shell_quote() {
	local value=$1

	printf "'"
	printf '%s' "$value" | sed "s/'/'\\\\''/g"
	printf "'"
}

shell_double_quote() {
	local value=$1

	printf '"'
	printf '%s' "$value" | sed 's/["\`$\\]/\\&/g'
	printf '"'
}

shell_word() {
	local value=$1

	if [[ $value =~ ^[A-Za-z0-9_@%+=:,./-]+$ ]]; then
		printf '%s\n' "$value"
	else
		shell_quote "$value"
	fi
}

sudo_privilege_failure() {
	local stderr=$1

	[[ $stderr =~ [Pp]assword ]] ||
		[[ $stderr =~ [Nn]o[[:space:]]+tty ]] ||
		[[ $stderr =~ [Tt]erminal[[:space:]]+is[[:space:]]+required ]] ||
		[[ $stderr =~ [Aa][[:space:]]+tty[[:space:]]+is[[:space:]]+required ]] ||
		[[ $stderr =~ [Aa]uthentication ]] ||
		[[ $stderr =~ [Nn]ot[[:space:]]+allowed ]] ||
		[[ $stderr =~ [Mm]ay[[:space:]]+not[[:space:]]+run[[:space:]]+sudo ]]
}

tilde_helper_path() {
	local command=$1

	local helper
	local root=${TILDE_ROOT:-}

	case $command in
	line | span)
		;;
	*)
		return 1
		;;
	esac

	if [[ -n $root && -x $root/bin/$command ]]; then
		printf '%s\n' "$root/bin/$command"
		return
	fi

	root=$(cd -P -- "${BASH_SOURCE[0]%/*}/.." >/dev/null && pwd)
	helper=$root/bin/$command
	[[ -x $helper ]] || return 1
	printf '%s\n' "$helper"
}

tilde_sudo_shim() {
	local sudo=$1

	local candidate
	local root
	local shim
	local -a shims

	candidate=$(canonical_path "$sudo" 2>/dev/null || true)
	root=$(cd -P -- "${BASH_SOURCE[0]%/*}/.." >/dev/null && pwd)
	shims=("$root/bin/sudo")
	[[ -z ${TILDE_ROOT:-} ]] || shims+=("$TILDE_ROOT/bin/sudo")

	for shim in "${shims[@]}"; do
		[[ -n $shim && -e $shim ]] || continue
		[[ $candidate == "$(canonical_path "$shim" 2>/dev/null || true)" ]] && return 0
	done

	grep -aq "Tilde sudo shim" "$sudo" 2>/dev/null
}

write_rule() {
	local path=$1
	local user=$2

	printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$user" >"$path"
}

# ------------------------------------------------------------------------------------------------------------------------
# Commands
# ------------------------------------------------------------------------------------------------------------------------

command.allow() {
	local user=${SUDO_USER:-${USER:-}}
	local user_given=0

	local sudo
	local tempfile

	while (($# > 0)); do
		case $1 in
		--user)
			(($# > 1)) || abort "--user needs a value"
			user=$2
			user_given=1
			shift 2
			;;
		--user=*)
			user=${1#*=}
			user_given=1
			shift
			;;
		*)
			abort "unknown allow option: $1"
			;;
		esac
	done

	if [[ -z $user && $user_given == 0 ]]; then
		user=$(id -un 2>/dev/null || true)
	fi
	[[ -n $user ]] || abort "could not determine target user"
	id "$user" >/dev/null 2>&1 || abort "unknown target user: $user"
	sudo=$(real_sudo) || abort "real sudo is missing"
	tempfile=$(mktemp) || exit
	trap 'rm -f "'"$tempfile"'"' EXIT
	trap 'rm -f "'"$tempfile"'"; exit 130' HUP INT QUIT TERM

	write_rule "$tempfile" "$user"
	"$sudo" visudo -cf "$tempfile" >/dev/null
	"$sudo" install -m 0440 "$tempfile" /etc/sudoers.d/tilde
	if ! "$sudo" visudo -cf /etc/sudoers.d/tilde >/dev/null; then
		"$sudo" rm -f /etc/sudoers.d/tilde
		abort "installed sudoers rule failed validation and was removed"
	fi

	printf 'OK: installed /etc/sudoers.d/tilde for %s\n' "$user"
	printf 'Cleanup: %s\n' "sudo rm -f /etc/sudoers.d/tilde"
}

command.cleanup() {
	local host=
	local sudo

	while (($# > 0)); do
		case $1 in
		--host)
			(($# > 1)) || abort "--host needs a value"
			host=$2
			shift 2
			;;
		--host=*)
			host=${1#*=}
			shift
			;;
		*)
			abort "unknown cleanup option: $1"
			;;
		esac
	done

	if [[ -n $host ]]; then
		remote_cleanup "$host"
		return
	fi

	sudo=$(real_sudo) || abort "real sudo is missing"
	"$sudo" rm -f /etc/sudoers.d/tilde
	printf 'OK: removed /etc/sudoers.d/tilde\n'
}

local_handoff_helper_supported() {
	local root=$1

	local path

	path=$(handoff_root_path "$root") || return 1
	[[ -x $path/bin/sudo ]] || return 1
	grep -aq -- '--handoff' "$path/bin/sudo"
}

remote_cleanup() {
	local host=$1
	local root

	root=$(cd -P -- "${BASH_SOURCE[0]%/*}/.." >/dev/null && pwd)
	"$root/bin/tilde" ssh --no-root "$host" <<'SH'
sudo_cmd=/usr/bin/sudo
[ -x "$sudo_cmd" ] || sudo_cmd=sudo

if [ ! -e /etc/sudoers.d/tilde ]; then
	printf 'OK: /etc/sudoers.d/tilde absent\n'
	exit 0
fi

"$sudo_cmd" -n rm -f /etc/sudoers.d/tilde
if [ -e /etc/sudoers.d/tilde ]; then
	printf 'E: /etc/sudoers.d/tilde still exists\n' >&2
	exit 1
fi

printf 'OK: removed /etc/sudoers.d/tilde\n'
SH
}

remote_handoff_helper_supported() {
	local host=$1
	local root=$2

	local script

	script=$(handoff_helper_check_script "$root")
	ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "sh -c $(shell_quote "$script")" >/dev/null 2>&1
}

command.handoff() {
	local copy=1
	local host=
	local root=\~/.agents/skills/tilde

	local command
	local remote
	local script
	local tool
	local tools

	while (($# > 0)); do
		case $1 in
		--copy)
			copy=1
			shift
			;;
		--no-copy)
			copy=0
			shift
			;;
		--host)
			(($# > 1)) || abort "--host needs a value"
			host=$2
			shift 2
			;;
		--host=*)
			host=${1#*=}
			shift
			;;
		--root)
			(($# > 1)) || abort "--root needs a value"
			root=$2
			shift 2
			;;
		--root=*)
			root=${1#*=}
			shift
			;;
		*)
			abort "unknown handoff option: $1"
			;;
		esac
	done

	if handoff_helper_supported "$host" "$root"; then
		command=$(handoff_command "$host" "$root")
	else
		script=$(handoff_script "$root")
		remote="sh -c $(shell_quote "$script")"
		if [[ -n $host ]]; then
			command="ssh -t $(shell_word "$host") $(shell_quote "$remote")"
		else
			command=$remote
		fi
	fi

	printf 'Handoff command:\n'
	printf '%s\n' "$command"
	if ((copy)); then
		if tool=$(copy_clipboard "$command"); then
			printf 'Clipboard: copied with %s.\n' "$tool"
		else
			if tools=$(clipboard_tools); then
				printf 'Clipboard: unavailable on this controller after trying %s; copy the command manually.\n' "$tools"
			else
				printf 'Clipboard: unavailable on this controller; copy the command manually.\n'
			fi
		fi
	fi
}

command.run() {
	if [[ ${TILDE_SUDO:-} != intercept ]]; then
		warn "E: Tilde sudo route is only available inside the Tilde execution environment"
		exit "$PRIVILEGE_EXIT"
	fi

	local command_index=0
	local helper
	local real
	local status
	local stderr
	local stdout
	local -a args=("$@")

	real=$(real_sudo) || {
		emit_privilege "sudo-missing"
		exit "$PRIVILEGE_EXIT"
	}
	stdout=$(mktemp) || exit
	stderr=$(mktemp) || exit
	trap 'rm -f "'"$stdout"'" "'"$stderr"'"' EXIT
	trap 'rm -f "'"$stdout"'" "'"$stderr"'"; exit 130' HUP INT QUIT TERM

	[[ ${args[0]:-} != -n ]] || command_index=1
	helper=$(tilde_helper_path "${args[$command_index]:-}" || true)
	if [[ -n $helper ]]; then
		args=("${args[@]:0:$command_index}" env "PATH=${PATH:-}" "$helper" "${args[@]:$((command_index + 1))}")
	fi

	if [[ ${args[0]:-} == -n ]]; then
		"$real" "${args[@]}" >"$stdout" 2>"$stderr" && status=0 || status=$?
	else
		"$real" -n "${args[@]}" >"$stdout" 2>"$stderr" && status=0 || status=$?
	fi

	cat "$stdout"
	cat "$stderr" >&2

	if ((status != 0)) && sudo_privilege_failure "$(cat "$stderr")"; then
		emit_privilege "sudo-auth" "$status"
		exit "$PRIVILEGE_EXIT"
	fi

	exit "$status"
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

usage() {
	cat <<-EOF
		Usage:
		  tilde sudo allow [--user USER]
		  tilde sudo cleanup [--host HOST]
		  tilde sudo handoff [--host HOST] [--root ROOT] [--copy|--no-copy]
	EOF
}

main() {
	local command=${1:-}

	case $command in
	allow | cleanup | handoff)
		shift
		"command.$command" "$@"
		;;
	--help | -h | help)
		usage
		;;
	--)
		shift
		command.run "$@"
		;;
	*)
		command.run "$@"
		;;
	esac
}

main "$@"
