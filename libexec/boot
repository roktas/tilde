#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

BOOTSTRAP_TOOL_BREW=
BOOTSTRAP_CHECK_REASON=
BOOTSTRAP_TOOL_CURL=
BOOTSTRAP_TOOL_GIT=
BOOTSTRAP_TOOL_RUBY=

abort() {
	warn "E: $*"
	exit 1
}

check_fail() {
	BOOTSTRAP_CHECK_REASON=$1
	return 1
}

warn() {
	printf '%s\n' "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

apt_lock_pids() {
	local -a locks=(
		/var/lib/apt/lists/lock
		/var/lib/dpkg/lock
		/var/lib/dpkg/lock-frontend
	)

	command -v fuser >/dev/null || return 0

	{ sudo_run fuser "${locks[@]}" 2>/dev/null || true; } | tr ' ' '\n' | sed '/^$/d' | sort -u
}

detect_platform() {
	case $(uname -s) in
	Darwin)
		echo macos
		;;
	Linux)
		echo linux
		;;
	*)
		abort "unsupported bootstrap platform: $(uname -s)"
		;;
	esac
}

find_tool() {
	local formula=$1
	local name=$2

	local found
	local path
	local prefix

	if prefix=$(brew --prefix "$formula" 2>/dev/null); then
		path=$prefix/bin/$name
		if [[ -x $path ]]; then
			printf '%s\n' "$path"
			return
		fi
	fi

	if found=$(command -v "$name" 2>/dev/null); then
		printf '%s\n' "$found"
		return
	fi

	return 1
}

find_homebrew() {
	local brew
	local -a candidates=(
		/opt/homebrew/bin/brew
		/usr/local/bin/brew
		"$HOME/.linuxbrew/bin/brew"
		/home/linuxbrew/.linuxbrew/bin/brew
	)

	if brew=$(command -v brew 2>/dev/null); then
		printf '%s\n' "$brew"
		return
	fi

	for brew in "${candidates[@]}"; do
		if [[ -x $brew ]]; then
			printf '%s\n' "$brew"
			return
		fi
	done

	return 1
}

host_name() {
	local host

	host=$(hostname -f 2>/dev/null || hostname)
	host=${host%%.*}
	printf '%s\n' "$host"
}

probe_bootstrap() {
	local platform=$1
	local shellenv

	case $platform in
	macos)
		xcode-select -p >/dev/null 2>&1 || {
			check_fail "xcode-command-line-tools-missing"
			return
		}
		;;
	esac

	BOOTSTRAP_TOOL_BREW=$(find_homebrew) || {
		check_fail "homebrew-missing"
		return
	}
	shellenv=$("$BOOTSTRAP_TOOL_BREW" shellenv) || {
		check_fail "homebrew-shellenv-failed"
		return
	}
	eval "$shellenv" || {
		check_fail "homebrew-shellenv-failed"
		return
	}

	BOOTSTRAP_TOOL_CURL=$(find_tool curl curl) || {
		check_fail "curl-missing"
		return
	}
	BOOTSTRAP_TOOL_GIT=$(find_tool git git) || {
		check_fail "git-missing"
		return
	}
	BOOTSTRAP_TOOL_RUBY=$(find_tool ruby ruby) || {
		check_fail "ruby-missing"
		return
	}

	"$BOOTSTRAP_TOOL_BREW" --prefix >/dev/null || {
		check_fail "homebrew-broken"
		return
	}
	"$BOOTSTRAP_TOOL_CURL" --version >/dev/null || {
		check_fail "curl-broken"
		return
	}
	"$BOOTSTRAP_TOOL_GIT" --version >/dev/null || {
		check_fail "git-broken"
		return
	}
	"$BOOTSTRAP_TOOL_RUBY" --version >/dev/null || {
		check_fail "ruby-broken"
		return
	}
}

run_apt() {
	sudo_run env DEBIAN_FRONTEND=noninteractive apt-get "$@"
}

sudo_run() {
	if [[ -t 0 ]]; then
		sudo "$@"
	else
		sudo -n "$@"
	fi
}

require_sudo() {
	local reason=$1

	command -v sudo >/dev/null || abort "sudo is required for $reason"
	[[ ! -t 0 ]] || return
	sudo -n true >/dev/null 2>&1 || abort "sudo is required for $reason; rerun bootstrap interactively or configure passwordless sudo"
}

stop_apt_maintenance() {
	command -v systemctl >/dev/null || return 0

	sudo_run systemctl stop apt-daily.timer apt-daily-upgrade.timer || true
	sudo_run systemctl stop apt-daily.service apt-daily-upgrade.service unattended-upgrades.service || true
}

wait_for_apt_locks() {
	local deadline=$((SECONDS + ${TILDE_BOOTSTRAP_APT_LOCK_WAIT:-120}))
	local mode=${TILDE_BOOTSTRAP_APT_LOCK:-wait}
	local -a pids

	while true; do
		mapfile -t pids < <(apt_lock_pids)
		((${#pids[@]} == 0)) && return

		warn "apt/dpkg lock is held by:"
		ps -fp "${pids[@]}" >&2 || true

		case $mode in
		fail)
			abort "apt/dpkg lock is busy"
			;;
		stop)
			stop_apt_maintenance
			mode="wait"
			;;
		wait)
			;;
		*)
			abort "unsupported TILDE_BOOTSTRAP_APT_LOCK: $mode"
			;;
		esac

		((SECONDS < deadline)) || abort "apt/dpkg lock did not clear; rerun with TILDE_BOOTSTRAP_APT_LOCK=stop to stop apt maintenance"
		sleep 5
	done
}

# ------------------------------------------------------------------------------------------------------------------------
# Commands
# ------------------------------------------------------------------------------------------------------------------------

ensure_command_line_tools() {
	if xcode-select -p >/dev/null 2>&1; then
		return
	fi

	xcode-select --install
	abort "Xcode Command Line Tools installation started; rerun bootstrap after it finishes"
}

apt_base_ready() {
	command -v curl >/dev/null &&
		command -v file >/dev/null &&
		command -v gcc >/dev/null &&
		command -v git >/dev/null &&
		command -v make >/dev/null &&
		command -v ps >/dev/null
}

install_apt_base() {
	command -v apt-get >/dev/null || return
	apt_base_ready && return

	require_sudo "apt base packages"
	wait_for_apt_locks
	run_apt update
	run_apt install -y --no-install-recommends build-essential ca-certificates curl file git procps
}

install_homebrew() {
	local platform=$1

	if find_homebrew >/dev/null; then
		return
	fi

	case $platform in
	linux)
		if [[ ! -t 0 && ! -w /home && ! -w /home/linuxbrew && ! -w /home/linuxbrew/.linuxbrew ]]; then
			require_sudo "Homebrew Linux prefix"
		fi
		;;
	macos)
		[[ -t 0 ]] || require_sudo "Homebrew installation"
		;;
	esac

	NONINTERACTIVE=1 bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	find_homebrew >/dev/null || abort "Homebrew installer completed but brew was not found"
}

load_homebrew() {
	local brew

	brew=$(find_homebrew) || abort "Homebrew is not installed"
	eval "$("$brew" shellenv)"
}

load_homebrew_tools() {
	local formula
	local prefix

	for formula in curl git ruby; do
		prefix=$(brew --prefix "$formula")
		PATH=$prefix/bin:$PATH
	done

	export PATH
	hash -r
}

persist_homebrew() {
	local platform=$1

	local line
	local profile

	case $platform in
	linux)
		profile=$HOME/.profile
		;;
	macos)
		profile=$HOME/.zprofile
		;;
	*)
		abort "unsupported bootstrap platform: $platform"
		;;
	esac

	line="eval \"\$($(brew --prefix)/bin/brew shellenv)\""

	touch "$profile"
	if ! grep -Fqx "$line" "$profile"; then
		printf '\n%s\n' "$line" >>"$profile"
	fi
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

usage() {
	cat <<-EOF
		Usage: boot [--check] [linux|macos]
	EOF
}

main() {
	local check=0
	local platform

	while (($# > 0)); do
		case $1 in
		--check)
			check=1
			shift
			;;
		--help)
			usage
			return
			;;
		linux | macos)
			[[ -z ${platform:-} ]] || {
				usage >&2
				return 2
			}
			platform=$1
			shift
			;;
		*)
			warn "E: unknown option or platform: $1"
			usage >&2
			return 2
			;;
		esac
	done

	if [[ -z ${platform:-} ]]; then
		platform=$(detect_platform)
	fi

	if ((check)); then
		probe_bootstrap "$platform" || abort "bootstrap baseline is missing or incomplete: ${BOOTSTRAP_CHECK_REASON:-unknown}"
		printf 'OK: bootstrap probe\n'
		return
	fi

	case $platform in
	linux)
		install_apt_base
		;;
	macos)
		ensure_command_line_tools
		;;
	*)
		abort "unsupported bootstrap platform: $platform"
		;;
	esac

	install_homebrew "$platform"
	load_homebrew
	persist_homebrew "$platform"

	brew update
	brew install curl git ruby
	load_homebrew_tools

	ruby --version
	git --version
	curl --version | head -n 1
}

main "$@"
