#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

cleanup_bundle=

abort() {
	warn "E: $*"
	exit 1
}

warn() {
	printf '%s\n' "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

branch_commit() {
	local repo=$1
	local branch=$2

	git -C "$repo" rev-parse --verify "$branch^{commit}"
}

cleanup_bundle_file() {
	[[ -z ${cleanup_bundle:-} ]] || rm -f -- "$cleanup_bundle"
}

check_clean() {
	local repo=$1

	local status

	status=$(git -C "$repo" status --porcelain=v1)
	[[ -z $status ]] || abort "dirty repository: $repo"
}

check_pushed() {
	local repo=$1
	local branch=$2

	local commit
	local upstream
	local upstream_commit

	upstream=$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name "$branch@{upstream}" 2>/dev/null) ||
		abort "branch has no upstream: $branch"
	commit=$(branch_commit "$repo" "$branch")
	upstream_commit=$(git -C "$repo" rev-parse --verify "$upstream^{commit}")
	[[ $commit = "$upstream_commit" ]] ||
		abort "branch is not at upstream: $branch ($commit != $upstream $upstream_commit)"
}

display_path() {
	local path=$1

	local home_alias='~'

	case $path in
	"$HOME")
		printf '%s' "$home_alias"
		;;
	"$HOME"/*)
		printf '%s/%s' "$home_alias" "${path#"$HOME"/}"
		;;
	*)
		printf '%s' "$path"
		;;
	esac
}

empty_dir() {
	local dir=$1

	[[ -d $dir ]] || return 1
	[[ -z $(find "$dir" -mindepth 1 -maxdepth 1 -print -quit) ]]
}

ensure_parent() {
	local path=$1

	local parent

	parent=$(dirname -- "$path")
	mkdir -p "$parent"
}

expand_path() {
	local path=$1

	case $path in
	\~)
		printf '%s\n' "$HOME"
		;;
	\~/*)
		printf '%s/%s\n' "$HOME" "${path#\~/}"
		;;
	*)
		printf '%s\n' "$path"
		;;
	esac
}

ensure_remote() {
	local repo=$1
	local remote=$2
	local origin=$3

	[[ -n $origin ]] || return
	if git -C "$repo" remote get-url "$remote" >/dev/null 2>&1; then
		git -C "$repo" remote set-url "$remote" "$origin"
	else
		git -C "$repo" remote add "$remote" "$origin"
	fi
}

origin_url() {
	local repo=$1

	git -C "$repo" remote get-url origin 2>/dev/null || true
}

pack_bundle() {
	local repo=$1
	local bundle=$2
	local branch=$3
	local allow_unpushed=$4

	[[ -d $repo/.git ]] || abort "repository is missing or not a Git checkout: $repo"
	check_clean "$repo"
	branch_commit "$repo" "$branch" >/dev/null
	((allow_unpushed)) || check_pushed "$repo" "$branch"
	[[ ! -e $bundle ]] || abort "bundle already exists: $bundle"
	ensure_parent "$bundle"
	git -C "$repo" bundle create "$bundle" "$branch"
	git -C "$repo" bundle verify "$bundle" >/dev/null 2>&1 || abort "invalid bundle: $bundle"
	printf 'OK: bundle %s %s\n' "$bundle" "$(git -C "$repo" rev-parse --short "$branch")"
}

receive_bundle() {
	local repo=$1
	local bundle=$2
	local branch=$3
	local remote=$4
	local origin=$5
	local replace_clean=$6

	local checkout_ref
	local current

	[[ -r $bundle ]] || abort "bundle is missing or unreadable: $bundle"
	checkout_ref="refs/tilde/checkout/$branch"

	if [[ -e $repo && ! -d $repo/.git ]] && ! empty_dir "$repo"; then
		abort "target exists but is not a Git checkout: $repo"
	fi

	if [[ -d $repo/.git ]]; then
		git -C "$repo" bundle verify "$bundle" >/dev/null 2>&1 || abort "invalid bundle: $bundle"
		check_clean "$repo"
		current=$(git -C "$repo" branch --show-current)
		[[ $current = "$branch" ]] || abort "target branch is $current, expected $branch"
		ensure_remote "$repo" "$remote" "$origin"
		git -C "$repo" fetch "$bundle" "+refs/heads/$branch:$checkout_ref"
		if git -C "$repo" merge-base --is-ancestor HEAD "$checkout_ref"; then
			git -C "$repo" merge --ff-only "$checkout_ref"
		elif ((replace_clean)); then
			git -C "$repo" reset --hard "$checkout_ref"
		else
			git -C "$repo" update-ref -d "$checkout_ref" >/dev/null 2>&1 || true
			abort "target cannot fast-forward: $repo"
		fi
		git -C "$repo" update-ref "refs/remotes/$remote/$branch" "$checkout_ref"
		git -C "$repo" update-ref -d "$checkout_ref" >/dev/null 2>&1 || true
	else
		ensure_parent "$repo"
		mkdir -p "$repo"
		git -C "$repo" init -q
		git -C "$repo" bundle verify "$bundle" >/dev/null 2>&1 || abort "invalid bundle: $bundle"
		ensure_remote "$repo" "$remote" "$origin"
		git -C "$repo" fetch "$bundle" "refs/heads/$branch:refs/remotes/$remote/$branch"
		git -C "$repo" checkout -q -B "$branch" "$remote/$branch"
	fi

	git -C "$repo" branch --set-upstream-to="$remote/$branch" "$branch" >/dev/null 2>&1 || true
	printf 'OK: checkout %s %s\n' "$repo" "$(git -C "$repo" rev-parse --short HEAD)"
}

remote_bundle_path() {
	local repo=$1
	local branch=$2

	local name
	local slug

	name=${repo##*/}
	slug=$(printf '%s-%s' "$name" "$branch" | tr -c 'A-Za-z0-9_.-' '_')
	printf '/tmp/tilde-checkout-%s-%s.bundle\n' "$slug" "$$"
}

runtime_link() {
	local source=$1
	local target=$2
	local expected=$3

	local current
	local source_commit
	local source_status
	local target_status

	[[ -d $source/.git ]] || abort "source is not a Git checkout: $source"
	[[ -x $source/bin/tilde ]] || abort "source is missing bin/tilde: $source"
	source_commit=$(git -C "$source" rev-parse HEAD) || abort "source has no commit: $source"
	source_status=$(git -C "$source" status --porcelain=v1 --untracked-files=no) || abort "source status failed: $source"
	[[ -z $source_status ]] || abort "source is dirty: $source"
	[[ -z $expected || $source_commit == "$expected" ]] || abort "source commit mismatch: $source_commit != $expected"

	if [[ -L $target ]]; then
		current=$(readlink "$target")
		if [[ $current == "$source" || $current == "$(display_path "$source")" ]]; then
			printf 'OK: runtime link %s -> %s\n' "$(display_path "$target")" "$(display_path "$source")"
			return
		fi
		abort "target symlink points elsewhere: $target -> $current"
	fi

	if [[ -e $target ]]; then
		if [[ -d $target/.git ]]; then
			target_status=$(git -C "$target" status --porcelain=v1 --untracked-files=no) ||
				abort "target status failed: $target"
			[[ -z $target_status ]] || abort "target checkout is dirty: $target"
			[[ -x $target/bin/tilde ]] || abort "target checkout is not a runtime checkout: $target"
		elif ! empty_dir "$target"; then
			abort "target exists but is not a clean runtime checkout: $target"
		fi
		rm -rf -- "$target"
	fi

	ensure_parent "$target"
	ln -s "$source" "$target"
	printf 'OK: runtime link %s -> %s\n' "$(display_path "$target")" "$(display_path "$source")"
}

runtime_link_local() {
	local source=$1
	local target=$2
	local expected=$3

	source=$(expand_path "$source")
	target=$(expand_path "$target")
	runtime_link "$source" "$target" "$expected"
}

runtime_link_remote() {
	local host=$1
	local source=$2
	local target=$3
	local expected=$4

	"$(tilde_root)/bin/tilde" ssh --no-root "$host" -- "$source" "$target" "$expected" <<'SH'
source_path=$1
target_path=$2
expected=$3

case $source_path in
\~)
	source_path=$HOME
	;;
\~/*)
	source_path=$HOME/${source_path#\~/}
	;;
esac
case $target_path in
\~)
	target_path=$HOME
	;;
\~/*)
	target_path=$HOME/${target_path#\~/}
	;;
esac

abort() {
	printf 'E: %s\n' "$*" >&2
	exit 1
}

display_path() {
	case $1 in
	"$HOME")
		printf '~'
		;;
	"$HOME"/*)
		printf '~/%s' "${1#"$HOME"/}"
		;;
	*)
		printf '%s' "$1"
		;;
	esac
}

empty_dir() {
	[ -d "$1" ] || return 1
	[ -z "$(find "$1" -mindepth 1 -maxdepth 1 -print -quit)" ]
}

[ -d "$source_path/.git" ] || abort "source is not a Git checkout: $source_path"
[ -x "$source_path/bin/tilde" ] || abort "source is missing bin/tilde: $source_path"
command -v git >/dev/null 2>&1 || abort "git is missing"
source_commit=$(git -C "$source_path" rev-parse HEAD) || abort "source has no commit: $source_path"
source_status=$(git -C "$source_path" status --porcelain=v1 --untracked-files=no) || abort "source status failed: $source_path"
[ -z "$source_status" ] || abort "source is dirty: $source_path"
if [ -n "$expected" ] && [ "$source_commit" != "$expected" ]; then
	abort "source commit mismatch: $source_commit != $expected"
fi

if [ -L "$target_path" ]; then
	current=$(readlink "$target_path")
	if [ "$current" = "$source_path" ] || [ "$current" = "$(display_path "$source_path")" ]; then
		printf 'OK: runtime link %s -> %s\n' "$(display_path "$target_path")" "$(display_path "$source_path")"
		exit 0
	fi
	abort "target symlink points elsewhere: $target_path -> $current"
fi

if [ -e "$target_path" ]; then
	if [ -d "$target_path/.git" ]; then
		target_status=$(git -C "$target_path" status --porcelain=v1 --untracked-files=no) || abort "target status failed: $target_path"
		[ -z "$target_status" ] || abort "target checkout is dirty: $target_path"
		[ -x "$target_path/bin/tilde" ] || abort "target checkout is not a runtime checkout: $target_path"
	elif ! empty_dir "$target_path"; then
		abort "target exists but is not a clean runtime checkout: $target_path"
	fi
	rm -rf "$target_path"
fi

mkdir -p "$(dirname -- "$target_path")"
ln -s "$source_path" "$target_path"
printf 'OK: runtime link %s -> %s\n' "$(display_path "$target_path")" "$(display_path "$source_path")"
SH
}

tilde_root() {
	cd -- "${BASH_SOURCE[0]%/*}/.." >/dev/null && pwd
}

# ------------------------------------------------------------------------------------------------------------------------
# Commands
# ------------------------------------------------------------------------------------------------------------------------

command.pack() {
	local allow_unpushed=0
	local branch=main
	local bundle=
	local repo=

	while (($# > 0)); do
		case $1 in
		--help | -h)
			usage_pack
			return
			;;
		--allow-unpushed)
			allow_unpushed=1
			shift
			;;
		--branch)
			(($# > 1)) || abort "--branch needs a value"
			branch=$2
			shift 2
			;;
		--bundle)
			(($# > 1)) || abort "--bundle needs a path"
			bundle=$2
			shift 2
			;;
		--repo)
			(($# > 1)) || abort "--repo needs a path"
			repo=$2
			shift 2
			;;
		*)
			abort "unknown pack option: $1"
			;;
		esac
	done

	[[ -n $repo ]] || abort "--repo is required"
	[[ -n $bundle ]] || abort "--bundle is required"
	pack_bundle "$repo" "$bundle" "$branch" "$allow_unpushed"
}

command.receive() {
	local branch=main
	local bundle=
	local origin=
	local remote=origin
	local replace_clean=0
	local repo=

	while (($# > 0)); do
		case $1 in
		--help | -h)
			usage_receive
			return
			;;
		--branch)
			(($# > 1)) || abort "--branch needs a value"
			branch=$2
			shift 2
			;;
		--bundle)
			(($# > 1)) || abort "--bundle needs a path"
			bundle=$2
			shift 2
			;;
		--origin)
			(($# > 1)) || abort "--origin needs a URL"
			origin=$2
			shift 2
			;;
		--remote)
			(($# > 1)) || abort "--remote needs a name"
			remote=$2
			shift 2
			;;
		--replace-clean)
			replace_clean=1
			shift
			;;
		--repo)
			(($# > 1)) || abort "--repo needs a path"
			repo=$2
			shift 2
			;;
		*)
			abort "unknown receive option: $1"
			;;
		esac
	done

	[[ -n $repo ]] || abort "--repo is required"
	[[ -n $bundle ]] || abort "--bundle is required"
	receive_bundle "$repo" "$bundle" "$branch" "$remote" "$origin" "$replace_clean"
}

command.remote() {
	local allow_unpushed=0
	local branch=main
	local bundle
	local host=
	local origin=
	local remote=origin
	local remote_bundle
	local replace_clean=0
	local repo=
	local target=

	while (($# > 0)); do
		case $1 in
		--help | -h)
			usage_remote
			return
			;;
		--allow-unpushed)
			allow_unpushed=1
			shift
			;;
		--branch)
			(($# > 1)) || abort "--branch needs a value"
			branch=$2
			shift 2
			;;
		--host)
			(($# > 1)) || abort "--host needs a value"
			host=$2
			shift 2
			;;
		--origin)
			(($# > 1)) || abort "--origin needs a URL"
			origin=$2
			shift 2
			;;
		--remote)
			(($# > 1)) || abort "--remote needs a name"
			remote=$2
			shift 2
			;;
		--replace-clean)
			replace_clean=1
			shift
			;;
		--repo)
			(($# > 1)) || abort "--repo needs a path"
			repo=$2
			shift 2
			;;
		--target)
			(($# > 1)) || abort "--target needs a path"
			target=$2
			shift 2
			;;
		*)
			abort "unknown remote option: $1"
			;;
		esac
	done

	[[ -n $host ]] || abort "checkout remote requires --host HOST"
	[[ -n $repo ]] || abort "checkout remote requires --repo CONTROLLER_REPO and --target TARGET_REPO"
	[[ -n $target ]] || abort "checkout remote requires --target TARGET_REPO"

	[[ -n $origin ]] || origin=$(origin_url "$repo")
	bundle=$(mktemp)
	rm -f "$bundle"
	remote_bundle=$(remote_bundle_path "$repo" "$branch")
	cleanup_bundle=$bundle
	trap cleanup_bundle_file EXIT
	trap 'cleanup_bundle_file; exit 130' HUP INT QUIT TERM

	pack_bundle "$repo" "$bundle" "$branch" "$allow_unpushed"
	scp "$bundle" "$host:$remote_bundle"
	"$(tilde_root)/bin/tilde" ssh --no-root "$host" -- "$target" "$remote_bundle" "$branch" "$remote" "$origin" "$replace_clean" <<'SH'
abort() {
	printf 'E: %s\n' "$*" >&2
	exit 1
}

empty_dir() {
	[ -d "$1" ] || return 1
	[ -z "$(find "$1" -mindepth 1 -maxdepth 1 -print -quit)" ]
}

repo=$1
bundle=$2
branch=$3
remote=$4
origin=$5
replace_clean=$6
checkout_ref="refs/tilde/checkout/$branch"
trap 'rm -f "$bundle"' EXIT HUP INT QUIT TERM

if [ ! -r "$bundle" ]; then
	abort "bundle is missing or unreadable: $bundle"
fi

if [ -e "$repo" ] && [ ! -d "$repo/.git" ] && ! empty_dir "$repo"; then
	abort "target exists but is not a Git checkout: $repo"
fi

if [ -d "$repo/.git" ]; then
	git -C "$repo" bundle verify "$bundle" >/dev/null 2>&1 || {
		abort "invalid bundle: $bundle"
	}
	status=$(git -C "$repo" status --porcelain=v1)
	if [ -n "$status" ]; then
		abort "dirty repository: $repo"
	fi
	current=$(git -C "$repo" branch --show-current)
	if [ "$current" != "$branch" ]; then
		abort "target branch is $current, expected $branch"
	fi
	if [ -n "$origin" ]; then
		if git -C "$repo" remote get-url "$remote" >/dev/null 2>&1; then
			git -C "$repo" remote set-url "$remote" "$origin"
		else
			git -C "$repo" remote add "$remote" "$origin"
		fi
	fi
	git -C "$repo" fetch "$bundle" "+refs/heads/$branch:$checkout_ref"
	if git -C "$repo" merge-base --is-ancestor HEAD "$checkout_ref"; then
		git -C "$repo" merge --ff-only "$checkout_ref"
	elif [ "$replace_clean" = 1 ]; then
		git -C "$repo" reset --hard "$checkout_ref"
	else
		git -C "$repo" update-ref -d "$checkout_ref" >/dev/null 2>&1 || true
		abort "target cannot fast-forward: $repo"
	fi
	git -C "$repo" update-ref "refs/remotes/$remote/$branch" "$checkout_ref"
	git -C "$repo" update-ref -d "$checkout_ref" >/dev/null 2>&1 || true
else
	parent=$(dirname -- "$repo")
	mkdir -p "$parent" "$repo"
	git -C "$repo" init -q
	git -C "$repo" bundle verify "$bundle" >/dev/null 2>&1 || {
		abort "invalid bundle: $bundle"
	}
	if [ -n "$origin" ]; then
		git -C "$repo" remote add "$remote" "$origin"
	fi
	git -C "$repo" fetch "$bundle" "refs/heads/$branch:refs/remotes/$remote/$branch"
	git -C "$repo" checkout -q -B "$branch" "$remote/$branch"
fi

git -C "$repo" branch --set-upstream-to="$remote/$branch" "$branch" >/dev/null 2>&1 || true
printf 'OK: checkout %s %s\n' "$repo" "$(git -C "$repo" rev-parse --short HEAD)"
SH
	cleanup_bundle_file
	cleanup_bundle=
	trap - EXIT HUP INT QUIT TERM
}

command.runtime-link() {
	local expected=
	local host=
	local source=
	local target=\~/.agents/skills/tilde

	while (($# > 0)); do
		case $1 in
		--help | -h)
			usage_runtime_link
			return
			;;
		--expected)
			(($# > 1)) || abort "--expected needs a commit"
			expected=$2
			shift 2
			;;
		--expected=*)
			expected=${1#*=}
			shift
			;;
		--host)
			(($# > 1)) || abort "--host needs a value"
			host=$2
			shift 2
			;;
		--host=*)
			host=${1#*=}
			shift
			;;
		--source)
			(($# > 1)) || abort "--source needs a path"
			source=$2
			shift 2
			;;
		--source=*)
			source=${1#*=}
			shift
			;;
		--target)
			(($# > 1)) || abort "--target needs a path"
			target=$2
			shift 2
			;;
		--target=*)
			target=${1#*=}
			shift
			;;
		*)
			abort "unknown runtime-link option: $1"
			;;
		esac
	done

	[[ -n $source ]] || abort "runtime-link requires --source SOURCE"

	if [[ -n $host ]]; then
		runtime_link_remote "$host" "$source" "$target" "$expected"
	else
		runtime_link_local "$source" "$target" "$expected"
	fi
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

usage() {
	cat <<-EOF
		Usage:
		  checkout pack --repo REPO --bundle BUNDLE [--branch BRANCH] [--allow-unpushed]
		  checkout receive --repo TARGET --bundle BUNDLE [--branch BRANCH] [--remote NAME] [--origin URL] [--replace-clean]
		  checkout remote --host HOST --repo REPO --target TARGET [--branch BRANCH] [--remote NAME] [--origin URL] [--allow-unpushed] [--replace-clean]
		  checkout runtime-link --source SOURCE [--target TARGET] [--expected COMMIT] [--host HOST]
	EOF
}

usage_pack() {
	cat <<-EOF
		Usage: checkout pack --repo REPO --bundle BUNDLE [--branch BRANCH] [--allow-unpushed]

		Create a Git bundle from a clean controller repository.
	EOF
}

usage_receive() {
	cat <<-EOF
		Usage: checkout receive --repo TARGET --bundle BUNDLE [--branch BRANCH] [--remote NAME] [--origin URL] [--replace-clean]

		Receive a bundle into a local target checkout.
	EOF
}

usage_remote() {
	cat <<-EOF
		Usage: checkout remote --host HOST --repo REPO --target TARGET [--branch BRANCH] [--remote NAME] [--origin URL] [--allow-unpushed] [--replace-clean]

		Bundle a clean controller repository, copy it to HOST, and update TARGET through Tilde SSH transport.
	EOF
}

usage_runtime_link() {
	cat <<-EOF
		Usage: checkout runtime-link --source SOURCE [--target TARGET] [--expected COMMIT] [--host HOST]

		Replace a clean runtime checkout with a symlink to a current source checkout.
	EOF
}

main() {
	local command

	(($# > 0)) || {
		usage >&2
		return 2
	}

	case $1 in
	--help)
		usage
		;;
	pack | receive | remote | runtime-link)
		command=$1
		shift
		"command.$command" "$@"
		;;
	*)
		warn "E: unknown command: $1"
		usage >&2
		return 2
		;;
	esac
}

main "$@"
