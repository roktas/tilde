#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

abort() {
	warn "E: $*"
	exit 2
}

warn() {
	printf '%s\n' "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

is_script_interpreter() {
	local command=$1

	case ${command##*/} in
	bash | dash | ksh | sh | zsh)
		return 0
		;;
	esac

	return 1
}

shell_quote() {
	local value=$1

	printf "'"
	printf '%s' "$value" | sed "s/'/'\\\\''/g"
	printf "'"
}

ssh_option_needs_value() {
	local option=$1

	case $option in
	-B | -b | -c | -D | -E | -e | -F | -I | -i | -J | -L | -l | -m | -O | -o | -p | -Q | -R | -S | -W | -w)
		return 0
		;;
	esac

	return 1
}

write_prelude() {
	local root=$1

	cat <<'SH'
set -eu
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.local/bin:$HOME/.bun/bin:$PATH"
export PATH

if [ -d "$HOME/.config/environment.d" ]; then
	for file in "$HOME"/.config/environment.d/*.conf; do
		[ -r "$file" ] || continue

		set -a
		. "$file"
		set +a
	done
fi
SH
	if [[ -n $root ]]; then
		if [[ $root == "\$HOME/.agents/skills/tilde" ]]; then
			printf '%s\n' "TILDE_ROOT=\${TILDE_ROOT:-\"\$HOME/.agents/skills/tilde\"}"
		else
			printf 'TILDE_ROOT=%s\n' "$(shell_quote "$root")"
		fi
		cat <<'SH'
export TILDE_ROOT
PATH="$TILDE_ROOT/bin:$PATH"
TILDE_SUDO=intercept
export PATH TILDE_SUDO
SH
	fi
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

usage() {
	cat <<-EOF
		Usage: "\$TILDE" ssh [--no-root] [--root ROOT] [--tty] HOST [-- [sh|bash|dash|ksh|zsh] [ARG...]]
	EOF
}

main() {
	local host=
	local interpreter=sh
	local root=\$HOME/.agents/skills/tilde
	local status
	local tempfile
	local -a remote_args=()
	local -a script_args=()
	local -a ssh_args=()

	while (($# > 0)); do
		case $1 in
		--help | -h)
			usage
			return
			;;
		--no-root)
			root=
			shift
			;;
		--root)
			(($# > 1)) || abort "--root needs a value"
			root=$2
			shift 2
			;;
		--root=*)
			root=${1#*=}
			shift
			;;
		--tty)
			ssh_args+=("-tt")
			shift
			;;
		--)
			shift
			remote_args=("$@")
			break
			;;
		-*)
			ssh_args+=("$1")
			if ssh_option_needs_value "$1"; then
				(($# > 1)) || abort "$1 needs a value"
				ssh_args+=("$2")
				shift 2
			else
				shift
			fi
			;;
		*)
			if [[ -z $host ]]; then
				host=$1
			else
				remote_args+=("$1")
			fi
			shift
			;;
		esac
	done

	[[ -n $host ]] || {
		usage >&2
		return 2
	}
	command -v ssh >/dev/null || abort "ssh is missing"
	[[ ! -t 0 ]] || abort "remote script body must be provided on stdin"
	tempfile=$(mktemp) || exit
	trap 'rm -f "'"$tempfile"'"' EXIT
	trap 'rm -f "'"$tempfile"'"; exit 130' HUP INT QUIT TERM

	cat >"$tempfile"
	if ((${#remote_args[@]} > 0)) && is_script_interpreter "${remote_args[0]}"; then
		interpreter=${remote_args[0]}
		script_args=("${remote_args[@]:1}")
	else
		script_args=("${remote_args[@]}")
	fi
	set +e
	{
		write_prelude "$root"
		cat "$tempfile"
	} | ssh "${ssh_args[@]}" "$host" "$interpreter" -s -- "${script_args[@]}"
	status=$?
	set -e

	if ((status != 0)); then
		warn "E: remote script failed on $host with exit $status"
	fi

	return "$status"
}

main "$@"
