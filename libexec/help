#!/usr/bin/env bash
# shellcheck disable=SC2016

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

readonly -a COMMANDS=(
	'adopt|agent|Propose adopting an app, config, package, or path into the public or private data repository.'
	'align|dual|Reconcile links, copies, seeds, and resets without bootstrap, packages, or module scripts.'
	'clean|agent|Propose conservative cleanup, including duplicate candidates when relevant.'
	'create|agent|Propose public/private home repository creation.'
	'deploy|agent|Prepare a host and install desired state.'
	'doctor|runtime|Diagnose state, repository, target, and managedness problems without executing module code.'
	'handoff|runtime|Copy and print the privilege handoff command for the local or remote host.'
	'help|runtime|Show public commands or detailed help for one public command.'
	'init|agent|Register existing public/private repositories on this host.'
	'organize|agent|Propose organization changes, including archive moves when relevant.'
	'repair|agent|Apply the current desired state again.'
	'status|runtime|Show compact repository bindings and last fully converged anchors.'
	'update|agent|Run explicit update behavior from the current desired state.'
	'upgrade|agent|Run the widest explicitly requested update path.'
)

readonly -a EXAMPLES=(
	'/tilde deploy|Discover local repositories and deploy this host.'
	'/tilde deploy spinoza|Deploy a remote host using target discovery.'
	'/tilde deploy vps --public PUBLIC_REPO|Deploy a Git-backed VPS with the public data repository.'
	'/tilde update spinoza|Update a remote host by planning and applying on that target.'
	'/tilde update WORK|Update every host in the WORK group defined by the active home policy.'
	'/tilde doctor spinoza|Run diagnostics on the remote target through Tilde SSH transport.'
	'/tilde adopt APP_OR_PATH|Propose adopting a new app, config, package, or path.'
	'/tilde repair|Apply current desired state again after a failed or deferred run.'
)

readonly -a IMPLEMENTATION_ROUTES=(
	apply
	boot
	checkout
	plan
	preflight
	smoke
	ssh
	sudo
)

abort() {
	warn "E: $*"
	exit 2
}

warn() {
	printf '%s\n' "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

entry_for() {
	local name=$1

	local item
	for item in "${COMMANDS[@]}"; do
		if [[ ${item%%|*} = "$name" ]]; then
			printf '%s\n' "$item"
			return 0
		fi
	done

	return 1
}

action_from() {
	local entry=$1

	entry=${entry#*|}
	printf '%s\n' "${entry#*|}"
}

kind_from() {
	local entry=$1

	entry=${entry#*|}
	printf '%s\n' "${entry%%|*}"
}

kind_note_for() {
	local kind=$1

	case $kind in
	agent)
		printf '%s\n' 'agent-orchestrated prompt command; the loaded Tilde skill runs the workflow'
		;;
	dual)
		printf '%s\n' 'direct local runtime route plus prompt workflow; remote targets are agent-orchestrated'
		;;
	runtime)
		printf '%s\n' 'direct bin/tilde runtime route for local targets; remote targets run through Tilde SSH transport'
		;;
	esac
}

is_implementation_route() {
	local name=$1

	local item
	for item in "${IMPLEMENTATION_ROUTES[@]}"; do
		if [[ $item = "$name" ]]; then
			return 0
		fi
	done

	return 1
}

usage_suffix_for() {
	local name=$1

	case $name in
	adopt)
		printf '%s\n' ' <app|config|package|path>'
		;;
	align)
		printf '%s\n' ' [host|ssh:<host>|GROUP] [--repo PATH] [--public PUBLIC_REPO] [--private PRIVATE_REPO] [dry-run|plan-only]'
		;;
	clean | organize)
		printf '%s\n' ' [subject] [dry-run|plan-only]'
		;;
	create)
		printf '%s\n' ' [public-repo] [private-repo]'
		;;
	deploy)
		printf '%s\n' ' [host|ssh:<host>|GROUP] [--public PUBLIC_REPO] [--private PRIVATE_REPO] [dry-run|plan-only]'
		;;
	doctor | status)
		printf '%s\n' ' [host|ssh:<host>|GROUP]'
		;;
	handoff)
		printf '%s\n' ' [--host HOST] [--root ROOT] [--copy|--no-copy]'
		;;
	help)
		printf '%s\n' ' [command]'
		;;
	init)
		printf '%s\n' ' [public-repo] [private-repo]'
		;;
	update)
		printf '%s\n' ' [host|ssh:<host>|GROUP] [full] [dry-run|plan-only]'
		;;
	repair)
		printf '%s\n' ' [host|ssh:<host>|GROUP] [dry-run|plan-only]'
		;;
	upgrade)
		printf '%s\n' ' [host|ssh:<host>|GROUP] [dry-run|plan-only]'
		;;
	esac
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

print_command_help() {
	local name=$1

	local action
	local entry
	local kind
	local suffix

	if [[ $name == custom.* ]]; then
		printf 'Custom Tilde command help is resolved from configured data repositories: `%s`.\n\n' "$name"
		printf 'This helper only lists built-in public commands; read the active `## Operations` policy for custom command details.\n\n'
		print_help
		return
	fi

	if ! entry=$(entry_for "$name"); then
		if is_implementation_route "$name"; then
			printf '`%s` is an implementation route, not a public prompt command.\n\n' "$name"
			printf 'Runtime usage: `"$TILDE" %s --help`\n' "$name"
			printf 'Do not run implementation routes as `/tilde %s ...` prompts.\n' "$name"
			return
		fi
		printf 'No such public Tilde command: `%s`.\n\n' "$name"
		print_help
		return
	fi

	action=$(action_from "$entry")
	kind=$(kind_from "$entry")
	suffix=$(usage_suffix_for "$name")

	printf '## `%s`\n\n' "$name"
	printf 'Prompt: `/tilde %s%s`\n\n' "$name" "$suffix"
	printf 'Kind: `%s` - %s.\n\n' "$kind" "$(kind_note_for "$kind")"
	printf '%s\n' "$action"

	if [[ $name = update ]]; then
		printf '\nImplementation note: `%s` uses planning mode `refresh`; do not use `--mode update`.\n' "$name"
		printf 'State recovery note: if target status shows missing `state.yml` or no `applied` anchors, use `plan --mode repair` for that run so successful apply can write recovered bindings and anchors; missing state is not proof the host was never deployed.\n'
	fi

	case $name in
	deploy | update | repair | upgrade)
		printf '\nRemote note: generate and apply plans on the target host through Tilde SSH transport.\n'
		printf 'Remote freshness note: before target status reads that gate a mutating workflow, plan, or apply, verify target runtime freshness and refresh stale Git-backed target checkouts; defer if they cannot be safely refreshed.\n'
		printf 'Remote verification note: after successful mutating apply, run a final target status read before closeout.\n'
		printf 'Remote state note: do not read controller `~/.local/state/tilde/state.yml`; target bindings and anchors come from the target host.\n'
		;;
	align)
		printf '\nRemote note: remote align is agent-orchestrated; deliver the target-side workflow through Tilde SSH transport.\n'
		printf 'Remote align note: do not run `tilde align --format json` on the target; generate `plan --mode align --format json` files for the target repositories and apply them with `tilde apply`.\n'
		printf 'Remote state note: do not read controller `~/.local/state/tilde/state.yml`; target bindings and anchors come from the target host.\n'
		;;
	doctor | status)
		printf '\nRemote note: deliver remote diagnostics through Tilde SSH transport; do not run target checks on the controller.\n'
		printf 'Remote state note: do not read controller `~/.local/state/tilde/state.yml`; target bindings and anchors come from the target host.\n'
		;;
	esac
}

print_help() {
	local example
	local item
	local kind
	local name

	printf 'Prompt format: `/tilde <command> [<arguments>...]`\n'
	printf 'This is an agent prompt marker, not a shell command. Do not execute `/tilde ...` or `$tilde ...` in a terminal.\n\n'
	printf '| Command | Kind | Action |\n'
	printf '| --- | --- | --- |\n'

	for item in "${COMMANDS[@]}"; do
		name=${item%%|*}
		kind=$(kind_from "$item")
		printf '| `%s` | `%s` | %s |\n' "$name" "$kind" "$(action_from "$item")"
	done

	printf '\n'
	printf 'Kinds: `agent` means interpreted by the loaded Tilde skill; `runtime` means a direct `bin/tilde` route; `dual` means both local runtime route and prompt workflow.\n'
	printf 'Runtime entrypoint: set `TILDE` to the loaded skill root `bin/tilde`; fallback `~/.agents/skills/tilde/bin/tilde`.\n'
	printf 'Do not search `PATH` after `tilde: command not found`; retry with `"$TILDE"`.\n'
	printf 'Target shorthand: omitted target means current host; bare `host` means `ssh:host` except when it names the current host; bare all-caps targets such as `ALL`, `HOME`, and `WORK` expand from the active home policy.\n'
	printf 'For defined host groups, report the expanded host list and continue; do not ask for permission to start the exact requested workflow.\n'
	printf 'When traversing a host group, skip hosts that fail a bounded noninteractive reachability check and continue with reachable hosts.\n'
	printf 'Run Tilde reachability probes through `"$TILDE" ssh`; do not use raw `ssh` for Tilde remote workflow probes.\n'
	printf 'For remote targets, generate plans and run live checks on the target host through Tilde SSH transport.\n'
	printf 'Write plan JSON files under a per-run `mktemp -d` directory and clean them with `trap`; do not leave fixed `/tmp/opencode/...` plan files.\n'
	printf 'Refresh/update mode does not advance `applied` anchors; report target HEAD separately from applied anchors.\n'
	printf 'After remote runtime freshness is verified, read target `tilde status --format json` and use `state.public` / `state.private` as plan repository bindings.\n'
	printf 'Bind remote plan repository paths to variables from target status JSON; do not retype host-convention paths in `plan --repo` commands.\n'
	printf 'Remote align uses target-local `plan --mode align` plus `apply`; do not run `tilde align --format json` on a remote target.\n'
	printf 'Do not redirect remote Tilde stderr to `/dev/null`; a non-zero remote exit means the step failed or deferred even when stdout is empty.\n'
	printf 'Remote script shell: default Tilde SSH uses POSIX `sh`; do not use Bash prelude, `pipefail`, `[[ ]]`, arrays, `source`, `local`, or `-- bash` for ordinary status, plan, apply, and verification scripts.\n'
	printf 'For mutating remote workflows, verify target runtime freshness before target status reads, plan, or apply; refresh stale Git-backed target checkouts first, or defer.\n'
	printf 'Runtime freshness checkout maps the loaded skill root to target `~/.agents/skills/tilde`; desired-state checkout maps the selected data repo to the target binding.\n'
	printf 'Remote freshness checkout route: use `"$TILDE" checkout remote --host HOST --repo CONTROLLER_REPO --target TARGET_REPO`; never call it with only `--host`.\n'
	printf 'For update targets with missing `state.yml` or no `applied` anchors, use `plan --mode repair` for state recovery instead of refresh; missing state is not proof the host was never deployed.\n'
	printf 'Status paths outside the `state.yml` model, such as `config.yml` or `hosts/HOST/state.md`, mean stale target runtime.\n'
	printf 'After successful mutating remote apply, run a final target status read and report target HEAD separately from applied anchors.\n'
	printf 'Do not read controller `~/.local/state/tilde/state.yml` for remote targets; target state lives on the target host.\n'
	printf '\n'
	printf 'Runtime help route: `"$TILDE" help <command>`\n'
	printf 'Bare `/tilde` prompt means `help`.\n'
	printf '\n'
	printf 'Example prompts:\n\n'
	printf '| Prompt | Intent |\n'
	printf '| --- | --- |\n'

	for example in "${EXAMPLES[@]}"; do
		printf '| `%s` | %s |\n' "${example%%|*}" "${example#*|}"
	done
}

usage() {
	cat <<'EOF'
Usage: help [--format markdown] [command]
EOF
}

main() {
	local format=markdown
	local subject=

	while [[ $# -gt 0 ]]; do
		case $1 in
		--format)
			shift
			[[ $# -gt 0 ]] || abort "--format requires an argument"
			format=$1
			;;
		--format=*)
			format=${1#--format=}
			;;
		-h | --help)
			usage
			exit 0
			;;
		-*)
			abort "Unknown option: $1"
			;;
		*)
			[[ -z $subject ]] || abort "Too many arguments"
			subject=$1
			;;
		esac
		shift
	done

	[[ $format = markdown ]] || abort "Only markdown format is supported"

	if [[ -n $subject ]]; then
		print_command_help "$subject"
	else
		print_help
	fi
}

main "$@"
