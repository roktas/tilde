#!/usr/bin/env ruby
# frozen_string_literal: true

require "date"
require "digest"
require "json"
require "open3"
require "optparse"
require "pathname"
require "rbconfig"
require "time"
require "yaml"

Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

class Plan
  SKILL_ROOT = Pathname.new(__dir__).parent.expand_path.freeze
  FALLBACK_ENTRYPOINT_SOURCE = "assets/AGENTS.md"
  HOME_ENTRYPOINT_TARGET = "~/AGENTS.md"
  PLAN_SCHEMA = "tilde.plan/v1"
  DEFAULT_PACKAGE_TYPE = {
    "linux" => "brew",
    "macos" => "brew",
    "windows" => "scoop"
  }.freeze
  LEVELS = {
    "minimal" => 1,
    "normal" => 5,
    "extra" => 10
  }.freeze
  MODES = %w[align apply refresh repair].freeze

  MANAGED_REFRESH_PACKAGE_TYPES = %w[flatpak gem github npm skill uv].freeze
  PACKAGE_TYPES = %w[brew cask deb flatpak gem github npm scoop skill uv].freeze
  PACKAGE_CONDITIONS = {
    "flatpak" => "graphical"
  }.freeze
  PHASES = %w[early normal].freeze
  SPECIAL_SECTIONS = ["Prerequisites", "Install", "Post Install", "Configure", "Update", "Notes"].freeze

  def initialize(options)
    @allow_dirty = options.fetch(:allow_dirty)
    @format = options.fetch(:format)
    @host = options[:host] || short_hostname
    @level = options[:level]
    @greedy = options.fetch(:greedy)
    @managed = options.fetch(:managed) || @greedy
    @mode = options.fetch(:mode)
    @platform = options[:platform] || detect_platform
    @repo = Pathname.new(options.fetch(:repo)).expand_path
  end

  def run
    validate_repo!
    validate_mode!
    validate_platform!
    validate_worktree!

    @head = git("rev-parse", "HEAD")
    @state = read_state
    @level = resolved_level
    validate_level!
    validate_refresh_options!

    modules = planned_modules
    core = core_plan(modules)

    plan = {
      schema: PLAN_SCHEMA,
      generated_at: Time.now.iso8601,
      repo: @repo.to_s,
      head: @head,
      branch: current_branch,
      dirty: dirty?,
      host: @host,
      level: @level,
      mode: @mode,
      managed: @managed,
      greedy: @greedy,
      platform: @platform,
      state_path: state_path.to_s,
      repository: repository_identity,
      target: target_identity,
      state: @state,
      core:,
      modules:
    }
    plan[:actions] = ordered_actions(plan)
    plan[:plan_id] = plan_id(plan)

    @format == "markdown" ? puts_markdown(plan) : puts(JSON.pretty_generate(plan))
  end

  private

  def action_id(base, used)
    id = base
    suffix = 2

    while used.key?(id)
      id = "#{base}:#{suffix}"
      suffix += 1
    end

    used[id] = true
    id
  end

  def active_config(frontmatter)
    all = normalize_map(frontmatter["all"])
    platform = normalize_map(frontmatter[@platform])

    merge_config(all, platform)
  end

  def active_system_packages(modules)
    packages = []
    packages << system_package("brew") if homebrew_active?(modules)
    packages << system_package("deb") if apt_active?
    packages << system_package("scoop") if scoop_active?(modules)
    packages
  end

  def align? = @mode == "align"

  def apply_like? = align? || apply? || repair?

  def install_like? = apply? || refresh? || repair?

  def materialize_like? = apply_like? || refresh?

  def actions_skipped? = !materialize_like?

  def converges? = apply? || refresh? || repair?

  def bash_blocks(body)
    fenced_blocks(body).filter_map do |info, content|
      block = content.strip
      block if bash_fence?(info) && !block.empty?
    end
  end

  def bash_fence?(info)
    %w[bash sh].include?(info.strip.split.first)
  end

  def canonicalize(value)
    case value
    when Array
      value.map { |item| canonicalize(item) }
    when Hash
      value.keys.map(&:to_s).sort.to_h do |key|
        original = value.key?(key.to_sym) ? key.to_sym : key
        [key, canonicalize(value[original])]
      end
    else
      value
    end
  end

  def content_hash(plan)
    content = canonicalize(plan.except(:generated_at, :plan_id))
    Digest::SHA256.hexdigest(JSON.generate(content))
  end

  def apt_active? = @platform == "linux" && command_available?("apt-get")

  def broad_upgrade_packages(modules)
    packages = []
    packages << system_package("cask") if homebrew_active?(modules)
    packages << system_package("deb") if apt_active?
    packages << system_package("flatpak") if flatpak_active?(modules)
    packages << system_package("scoop") if scoop_active?(modules)
    packages
  end

  def command_available?(name)
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
      path = File.join(dir, name)
      File.file?(path) && File.executable?(path)
    end
  end

  def current_branch
    git("branch", "--show-current")
  rescue StandardError
    nil
  end

  def configure_update_packages(modules)
    return modules unless refresh?

    modules.each do |mod|
      mod[:packages_to_refresh] = []
      mod[:packages_to_upgrade] = []
    end

    if @managed
      add_managed_refresh_packages(modules)
    else
      add_fast_refresh_packages(modules)
    end

    add_broad_upgrade_packages(modules) if @greedy
    modules
  end

  def core_plan(modules)
    {
      links_to_create: [],
      links_to_remove: stale_link_actions(modules),
      home_entrypoints_to_write: fallback_entrypoint_needed?(modules) ? fallback_entrypoints : []
    }
  end

  def copy_action(mod, copy) = file_action(mod, copy, "copy")

  def directory_action(mod, directory)
    {
      id: "#{mod.fetch(:id)}:directory:#{directory.fetch(:target)}",
      kind: "directory",
      module_id: mod.fetch(:id),
      module_name: mod.fetch(:name),
      phase: mod.fetch(:phase),
      repo_role: mod.fetch(:repo_role),
      target: directory.fetch(:target),
      conflict: {
        strategy: "none"
      }
    }
  end

  def seed_action(mod, seed) = file_action(mod, seed, "seed")

  def reset_action(mod, reset) = file_action(mod, reset, "reset")

  def file_action(mod, file, kind)
    {
      id: "#{mod.fetch(:id)}:#{kind}:#{file.fetch(:source)}->#{file.fetch(:target)}",
      kind:,
      module_id: mod.fetch(:id),
      module_name: mod.fetch(:name),
      phase: mod.fetch(:phase),
      repo_role: mod.fetch(:repo_role),
      source: file.fetch(:source),
      source_path: file.fetch(:source_path),
      target: file.fetch(:target),
      conflict: {
        strategy: "none"
      }
    }
  end

  def commit_available?(commit)
    git("cat-file", "-e", "#{commit}^{commit}")
    true
  rescue StandardError
    false
  end

  def current_link_action_keys
    current_link_actions
      .map { |action| link_action_key(action) }
      .to_h { |key| [key, true] }
  end

  def current_link_actions
    current_link_pairs.map do |mod, link|
      link_plan_action(mod, link)
    end
  end

  def current_link_pairs
    ordered_module_dirs.flat_map do |dir|
      frontmatter, body = frontmatter_and_body(dir.join("README.md"))
      next [] unless module_applicable?(frontmatter, body)

      config = active_config(frontmatter)
      level = module_level(frontmatter, config)
      module_name = dir.relative_path_from(@repo).to_s
      validate_module_level(module_name, level)
      next [] unless level_allowed?(level)
      next [] unless host_allowed?(config)

      mod = {
        id: module_id(module_name),
        name: module_name,
        phase: module_phase(frontmatter, config),
        repo_role:
      }
      normalize_links(config, dir).map { |link| [mod, link] }
    end
  end

  def fallback_entrypoint_needed?(modules)
    apply_like? && !home_entrypoint_linked_by_module?(modules) && !home_entrypoint_linked_by_companion?
  end

  def fallback_entrypoints
    source_path = SKILL_ROOT.join(FALLBACK_ENTRYPOINT_SOURCE)
    [
      {
        source: FALLBACK_ENTRYPOINT_SOURCE,
        source_path: source_path.to_s,
        target: HOME_ENTRYPOINT_TARGET,
        source_sha256: Digest::SHA256.file(source_path).hexdigest,
        strategy: "write-fallback-file"
      }
    ]
  end

  def flatpak_active?(modules) = command_available?("flatpak") || package_type_present?(modules, %w[flatpak])

  def managed_refresh_packages(packages)
    packages.select { |package| MANAGED_REFRESH_PACKAGE_TYPES.include?(package.fetch(:type)) }
  end

  def homebrew_active?(modules) = command_available?("brew") || package_type_present?(modules, %w[brew cask])

  def add_broad_upgrade_packages(modules)
    target = update_package_module(modules)
    return unless target

    target[:packages_to_upgrade].concat(broad_upgrade_packages(modules))
  end

  def add_fast_refresh_packages(modules)
    target = update_package_module(modules)
    return unless target

    target[:packages_to_refresh].concat(active_system_packages(modules))
  end

  def add_managed_refresh_packages(modules)
    add_fast_refresh_packages(modules)

    modules.each do |mod|
      mod[:packages_to_refresh].concat(managed_refresh_packages(mod.fetch(:packages)))
    end
  end

  def package_type_present?(modules, types)
    modules.any? do |mod|
      mod.fetch(:packages).any? { |package| types.include?(package.fetch(:type)) }
    end
  end

  def scoop_active?(modules)
    @platform == "windows" && (command_available?("scoop") || package_type_present?(modules, %w[scoop]))
  end

  def system_package(type)
    {
      type:,
      name: "*",
      value: "#{type}:*",
      system: true,
      condition: PACKAGE_CONDITIONS[type]
    }.compact
  end

  def update_package_module(modules)
    return nil if repo_role == "private" && companion_repo

    modules.find { |mod| mod.fetch(:name) == @platform } || modules.first
  end

  def home_entrypoint_linked_by_module?(modules)
    modules.any? do |mod|
      mod[:home_entrypoint] || Array(mod[:links_to_create]).any? { |link| link[:target] == HOME_ENTRYPOINT_TARGET }
    end
  end

  def home_entrypoint_linked_by_companion?
    repo = companion_repo
    return false unless repo

    readme = repo.join("home", "README.md")
    return false unless readme.file?

    frontmatter, = frontmatter_and_body(readme)
    home_entrypoint_declared?(active_config(frontmatter))
  rescue StandardError
    false
  end

  def detect_platform
    host_os = RbConfig::CONFIG.fetch("host_os")

    case host_os
    when /darwin/i
      "macos"
    when /linux/i
      "linux"
    when /mswin|mingw|cygwin/i
      "windows"
    else
      raise "Unsupported platform: #{host_os}"
    end
  end

  def dirty?
    !git("status", "--porcelain", "--untracked-files=no").empty?
  end

  def companion_repo
    agents = @repo.join("AGENTS.md")
    return nil unless agents.file?

    tilde = tilde_frontmatter(agents)
    key = companion_repo_key(tilde)

    return nil unless key && tilde[key]

    path = companion_repo_path(tilde[key])
    path.directory? ? path : nil
  end

  def companion_repo_key(tilde)
    case tilde["role"]
    when "public"
      "private"
    when "private"
      "public"
    end
  end

  def companion_repo_path(path)
    repo = Pathname.new(path.to_s)
    repo.absolute? ? repo : @repo.join(repo).cleanpath
  end

  def frontmatter_and_body(path)
    text = path.read
    frontmatter_and_body_text(text)
  end

  def frontmatter_and_body_text(text)
    return [{}, text] unless text.start_with?("---\n")

    _, yaml_text, body = text.split(/^---\s*$\n?/, 3)
    [YAML.safe_load(yaml_text, aliases: true, permitted_classes: [Date, Time]) || {}, body || ""]
  end

  def git(*)
    stdout, stderr, status = Open3.capture3("git", "-C", @repo.to_s, *)
    raise stderr.strip unless status.success?

    stdout.strip
  end

  def host_allowed?(config)
    hosts = Array(config["hosts"]).map(&:to_s)
    hosts.empty? || hosts.include?(@host)
  end

  def entrypoint_action(entrypoint)
    {
      id: "core:entrypoint:#{entrypoint.fetch(:target)}",
      kind: "entrypoint",
      module_id: "core",
      module_name: "core",
      repo_role:,
      source: entrypoint.fetch(:source),
      source_path: entrypoint.fetch(:source_path),
      target: entrypoint.fetch(:target),
      source_sha256: entrypoint.fetch(:source_sha256),
      conflict: {
        strategy: entrypoint.fetch(:strategy)
      }
    }
  end

  def level_allowed?(level)
    LEVELS.fetch(level) <= LEVELS.fetch(@level)
  end

  def merge_config(all, platform)
    all.merge(platform) do |_key, old_value, new_value|
      old_value.is_a?(Hash) && new_value.is_a?(Hash) ? old_value.merge(new_value) : new_value
    end
  end

  def module_applicable?(frontmatter, body)
    return true if frontmatter.empty? || frontmatter.key?("all") || frontmatter.key?(@platform)
    return true if body_platform_applicable?(body)

    platform_keys = DEFAULT_PACKAGE_TYPE.keys
    !frontmatter.keys.intersect?(platform_keys)
  end

  def body_platform_applicable?(body)
    platform_scopes(body).any? do |scope|
      ["all", @platform].include?(scope.fetch(:platform))
    end
  end

  def module_level(frontmatter, config)
    level = (frontmatter["level"] || config["level"] || "normal").to_s
    raise "Unsupported level: #{level}" unless LEVELS.key?(level)

    level
  end

  def module_phase(frontmatter, config)
    phase = (frontmatter["phase"] || config["phase"] || "normal").to_s
    raise "Unsupported phase: #{phase}" unless PHASES.include?(phase)

    phase
  end

  def validate_module_level(module_name, level)
    raise "misc- must use level: extra" if module_name == "misc-" && level != "extra"
  end

  def module_dirs
    @repo
      .children
      .select(&:directory?)
      .reject { |path| ignored_root_dir?(path) }
      .select { |path| path.join("README.md").file? }
      .sort_by { |path| path.basename.to_s }
  end

  def ignored_root_dir?(path)
    name = path.respond_to?(:basename) ? path.basename.to_s : File.basename(path.to_s)
    name.start_with?(".") || DEFAULT_PACKAGE_TYPE.key?(name) || platform_variant?(name)
  end

  def platform_variant?(name)
    DEFAULT_PACKAGE_TYPE.keys.any? { |platform| name == "#{platform}-" }
  end

  def normalize_copies(config, dir) = normalize_files(config, dir, "copies")

  def normalize_directories(config)
    return [] unless config.key?("directories")

    normalize_sequence(config["directories"], "directories").map do |target|
      raise "directories item must be a string" unless target.is_a?(String)

      {target:}
    end
  end

  def normalize_resets(config, dir) = normalize_files(config, dir, "resets")

  def normalize_seeds(config, dir) = normalize_files(config, dir, "seeds")

  def normalize_files(config, dir, key)
    normalize_map(config[key]).map do |source, target|
      {
        source:,
        source_path: source_path(dir, source),
        target:
      }
    end
  end

  def normalize_links(config, dir)
    normalize_map(config["links"]).flat_map do |source, targets|
      normalize_link_targets(targets, source).flat_map do |target|
        link_actions(dir, source, target)
      end
    end
  end

  def normalize_link_targets(value, source)
    targets = value.is_a?(Array) ? value : [value]
    raise "links target list must not be empty for #{source}" if targets.empty?

    targets.map do |target|
      raise "links target must be a string for #{source}" unless target.is_a?(String)

      target
    end
  end

  def link_actions(dir, source, target)
    return external_link_actions(dir, source, target) if external_source?(source)

    return [link_action(dir, source, target)] unless source.end_with?("/")

    fan_in_link_actions(dir, source, target)
  end

  def external_link_actions(dir, source, target)
    raise "external link source cannot use fan-in: #{source}" if source.end_with?("/")

    [link_action(dir, source, target)]
  end

  def fan_in_children(dir, source, source_dir)
    return source_dir.children.sort_by { |child| child.basename.to_s } if @allow_dirty

    relative_dir = dir.relative_path_from(@repo).join(source).cleanpath.to_s
    tree_children_at(@head, relative_dir).map { |child| source_dir.join(Pathname.new(child).basename) }
  end

  def fan_in_link_actions(dir, source, target)
    source_dir = Pathname.new(source_path(dir, source))
    raise "Link fan-in source is not a directory: #{source}" unless source_dir.directory?

    fan_in_children(dir, source, source_dir).filter_map do |child|
      next if suppressed_fan_in_child?(source, target, child)

      child_source = File.join(source, child.basename.to_s)
      child_target = File.join(target, child.basename.to_s)
      link_action(dir, child_source, child_target, fan_in_metadata(source, target))
    end
  end

  def link_action(dir, source, target, metadata = {})
    source_path = external_source?(source) ? external_source_path(source).to_s : source_path(dir, source)

    {
      source:,
      source_path:,
      source_external: external_source?(source),
      target:,
      fan_in: false,
      fan_in_source: nil,
      fan_in_target: nil
    }.merge(metadata)
  end

  def link_plan_action(mod, link)
    {
      id: "#{mod.fetch(:id)}:link:#{link.fetch(:source)}->#{link.fetch(:target)}",
      kind: "link",
      module_id: mod.fetch(:id),
      module_name: mod.fetch(:name),
      phase: mod.fetch(:phase),
      repo_role: mod.fetch(:repo_role),
      source: link.fetch(:source),
      source_path: link.fetch(:source_path),
      source_external: link.fetch(:source_external, false),
      target: link.fetch(:target),
      link_value: link_value(link.fetch(:source_path), link.fetch(:target)),
      fan_in: link.fetch(:fan_in),
      fan_in_source: link.fetch(:fan_in_source),
      fan_in_target: link.fetch(:fan_in_target),
      conflict: {
        strategy: "none"
      }
    }
  end

  def link_action_key(action)
    [action.fetch(:target), action.fetch(:link_value)]
  end

  def previous_link_pairs_at(commit)
    module_dirs_at(commit).flat_map do |dir|
      readme = readme_at(commit, dir)
      frontmatter, body = frontmatter_and_body_text(readme)
      next [] unless module_applicable?(frontmatter, body)

      config = active_config(frontmatter)
      level = module_level(frontmatter, config)
      validate_module_level(dir, level)
      next [] unless level_allowed?(level)
      next [] unless host_allowed?(config)

      mod = {
        id: module_id(dir),
        name: dir,
        phase: module_phase(frontmatter, config),
        repo_role:
      }
      normalize_links_at(commit, config, dir).map { |link| [mod, link] }
    end
  end

  def module_id(module_name)
    "#{repo_role}/#{module_name}"
  end

  def link_value(source_path, target)
    source = Pathname.new(source_path).expand_path
    target_path = target_path(target)
    source_dropbox = dropbox_path(source)
    target_dropbox = dropbox_path(target_path)

    return source_path unless source_dropbox && target_dropbox

    source_dropbox.relative_path_from(target_dropbox.dirname).to_s
  end

  def external_source?(source)
    value = source.to_s
    value.start_with?("~/") || value.start_with?("/")
  end

  def external_source_path(source)
    path = target_path(source)
    raise "External link source escapes home: #{source}" unless path_inside?(path, Pathname.new(Dir.home))

    path
  end

  def path_inside?(path, root)
    path = path.expand_path
    root = root.expand_path
    path.to_s == root.to_s || path.to_s.start_with?("#{root}/")
  end

  def dropbox_path(path)
    names = path.expand_path.each_filename.to_a
    index = names.rindex("Dropbox")
    return nil unless index

    Pathname.new(File.join("/", "Dropbox", *names[(index + 1)..]))
  end

  def target_path(target)
    value = target.to_s
    value = File.join(Dir.home, value.delete_prefix("~/")) if value.start_with?("~/")
    Pathname.new(value).expand_path
  end

  def fan_in_metadata(source, target)
    {
      fan_in: true,
      fan_in_source: source,
      fan_in_target: target
    }
  end

  def normalize_map(value)
    value.is_a?(Hash) ? value : {}
  end

  def normalize_package(package)
    value = package.to_s
    type, name = value.include?(":") ? value.split(":", 2) : [DEFAULT_PACKAGE_TYPE.fetch(@platform), value]
    raise "Package type must not be empty: #{value}" if type.empty?
    raise "Unsupported package type: #{type}" unless PACKAGE_TYPES.include?(type)
    raise "Package name must not be empty: #{value}" if name.empty?

    {
      type:,
      name:,
      value: "#{type}:#{name}",
      condition: PACKAGE_CONDITIONS[type]
    }.compact
  end

  def normalize_packages(config)
    return [] unless config.key?("packages")

    normalize_sequence(config["packages"], "packages").map { |package| normalize_package(package) }
  end

  def normalize_sequence(value, key)
    raise "#{key} must be a list" unless value.is_a?(Array)

    value
  end

  def module_dirs_at(commit)
    dirs = root_readme_dirs_at(commit)
    platform_dirs = platform_module_dirs(dirs)

    platform_dirs + dirs.reject { |dir| platform_dirs.include?(dir) || ignored_root_dir?(dir) }
  end

  def root_readme_dirs_at(commit)
    git("ls-tree", "-r", "--name-only", commit)
      .lines(chomp: true)
      .filter_map { |path| path.end_with?("/README.md") ? File.dirname(path) : nil }
      .sort
      .uniq
      .reject { |path| path == "." || path.include?("/") }
  end

  def platform_module_dirs(dirs)
    [@platform, "#{@platform}-"].select { |dir| dirs.include?(dir) }
  end

  def normalize_links_at(commit, config, dir)
    normalize_map(config["links"]).flat_map do |source, targets|
      normalize_link_targets(targets, source).flat_map do |target|
        link_actions_at_commit(commit, dir, source, target)
      end
    end
  end

  def link_actions_at_commit(commit, dir, source, target)
    if external_source?(source)
      raise "external link source cannot use fan-in: #{source}" if source.end_with?("/")

      return [link_action_at(dir, source, target)]
    end

    return [link_action_at(dir, source, target)] unless source.end_with?("/")

    source_dir = File.join(dir, source)
    tree_children_at(commit, source_dir).filter_map do |child|
      child_path = Pathname.new(child)
      next if suppressed_fan_in_child?(source, target, child_path)

      child_source = File.join(source, child_path.basename.to_s)
      child_target = File.join(target, child_path.basename.to_s)
      link_action_at(dir, child_source, child_target, fan_in_metadata(source, target))
    end
  end

  def link_action_at(dir, source, target, metadata = {})
    source_path = external_source?(source) ? external_source_path(source).to_s : source_path_at(dir, source)

    {
      source:,
      source_path:,
      source_external: external_source?(source),
      target:,
      fan_in: false,
      fan_in_source: nil,
      fan_in_target: nil
    }.merge(metadata)
  end

  def package_actions(packages, mode)
    return packages if mode == "apply" && install_like?

    []
  end

  def empty_files
    {
      directories_to_create: [],
      links_to_create: [],
      copies_to_create: [],
      resets_to_create: [],
      seeds_to_create: []
    }
  end

  def module_files(config, dir)
    return empty_files if actions_skipped?

    {
      directories_to_create: normalize_directories(config),
      links_to_create: normalize_links(config, dir),
      copies_to_create: normalize_copies(config, dir),
      resets_to_create: normalize_resets(config, dir),
      seeds_to_create: normalize_seeds(config, dir)
    }
  end

  def planned_module(dir)
    readme = dir.join("README.md")
    frontmatter, body = frontmatter_and_body(readme)
    return nil unless module_applicable?(frontmatter, body)

    config = active_config(frontmatter)
    level = module_level(frontmatter, config)
    module_name = dir.relative_path_from(@repo).to_s

    validate_module_level(module_name, level)
    return nil unless level_allowed?(level)
    return nil unless host_allowed?(config)

    files = module_files(config, dir)
    home_entrypoint = home_entrypoint_declared?(config)
    packages = normalize_packages(config)
    phase = module_phase(frontmatter, config)
    sections = section_actions(body)

    {
      id: module_id(module_name),
      name: module_name,
      repo_role:,
      readme: readme.to_s,
      level:,
      phase:,
      home_entrypoint:,
      packages:,
      packages_to_install: align? ? [] : package_actions(packages, "apply"),
      packages_to_refresh: [],
      packages_to_upgrade: [],
      directories_to_create: files.fetch(:directories_to_create),
      links_to_create: files.fetch(:links_to_create),
      copies_to_create: files.fetch(:copies_to_create),
      resets_to_create: files.fetch(:resets_to_create),
      seeds_to_create: files.fetch(:seeds_to_create),
      special_sections: sections,
      skipped: false,
      skip_reason: nil,
      virtual: !config.key?("packages") && sections.empty?
    }
  end

  def planned_modules
    configure_update_packages(ordered_module_dirs.filter_map { |dir| planned_module(dir) })
  end

  def ordered_module_dirs
    platform_dir = @repo.join(@platform)
    platform_variant_dir = @repo.join("#{@platform}-")
    dirs = []
    dirs << platform_dir if platform_dir.join("README.md").file?
    dirs << platform_variant_dir if platform_variant_dir.join("README.md").file?
    dirs.concat(module_dirs.reject { |dir| [platform_dir, platform_variant_dir].include?(dir) })
    dirs
  end

  def home_entrypoint_declared?(config)
    normalize_map(config["links"]).any? do |_source, targets|
      (targets.is_a?(Array) ? targets : [targets]).any? { |target| target.to_s == HOME_ENTRYPOINT_TARGET }
    end
  end

  def align_module_actions(mod)
    materialization_actions(mod)
  end

  def materialization_actions(mod)
    mod.fetch(:directories_to_create).map { |dir| directory_action(mod, dir) } +
      mod.fetch(:links_to_create).map { |link| link_plan_action(mod, link) } +
      mod.fetch(:copies_to_create).map { |copy| copy_action(mod, copy) } +
      mod.fetch(:seeds_to_create).map { |seed| seed_action(mod, seed) } +
      mod.fetch(:resets_to_create).map { |reset| reset_action(mod, reset) }
  end

  def module_actions(mod)
    actions = []
    actions.concat(section_plan_actions(mod, %w[Prerequisites]))
    actions.concat(package_plan_actions(mod, "install", mod.fetch(:packages_to_install)))
    actions.concat(section_plan_actions(mod, %w[Install]))
    actions.concat(section_plan_actions(mod, ["Post Install"], run_if: {install_changed: true}))
    actions.concat(materialization_actions(mod))
    actions.concat(section_plan_actions(mod, %w[Configure]))
    actions
  end

  def refresh_module_actions(mod)
    actions = []
    actions.concat(package_plan_actions(mod, "refresh", mod.fetch(:packages_to_refresh)))
    actions.concat(section_plan_actions(mod, %w[Prerequisites]))
    actions.concat(package_plan_actions(mod, "install", mod.fetch(:packages_to_install)))
    actions.concat(section_plan_actions(mod, %w[Install]))
    actions.concat(section_plan_actions(mod, ["Post Install"], run_if: {install_changed: true}))
    actions.concat(materialization_actions(mod))
    actions.concat(section_plan_actions(mod, %w[Update]))
    actions.concat(section_plan_actions(mod, %w[Configure]))
    actions
  end

  def upgrade_module_actions(mod)
    package_plan_actions(mod, "upgrade", mod.fetch(:packages_to_upgrade))
  end

  def ordered_actions(plan)
    actions = plan.fetch(:core).fetch(:home_entrypoints_to_write).map { |entrypoint| entrypoint_action(entrypoint) }
    actions.concat(plan.fetch(:core).fetch(:links_to_remove))
    used = {}

    ordered_module_actions(plan.fetch(:modules)).each do |action|
      action[:id] = action_id(action.fetch(:id), used)
      actions << action
    end

    actions
  end

  def ordered_module_actions(modules)
    return modules.flat_map { |mod| align_module_actions(mod) } if align?
    return ordered_refresh_actions(modules) if refresh?

    modules.flat_map { |mod| module_actions(mod) }
  end

  def ordered_refresh_actions(modules)
    actions = modules.flat_map { |mod| refresh_module_actions(mod) }
    actions.concat(modules.flat_map { |mod| upgrade_module_actions(mod) }) if @greedy
    actions
  end

  def package_plan_actions(mod, operation, packages)
    packages.map do |package|
      {
        id: "#{mod.fetch(:id)}:package:#{operation}:#{package.fetch(:value)}",
        kind: "package",
        module_id: mod.fetch(:id),
        module_name: mod.fetch(:name),
        phase: mod.fetch(:phase),
        repo_role: mod.fetch(:repo_role),
        operation:,
        package:,
        condition: package[:condition],
        conflict: {
          strategy: "none"
        }
      }.compact
    end
  end

  def previous_link_actions
    commit = previous_commit
    return [] unless commit && commit_available?(commit)

    previous_link_pairs_at(commit).map do |mod, link|
      link_plan_action(mod, link)
    end
  end

  def previous_commit
    @state&.dig("applied", repo_role)
  end

  def plan_id(plan)
    "sha256:#{content_hash(plan)}"
  end

  def puts_markdown(plan)
    puts("# Tilde Plan")
    puts
    puts("- schema: `#{plan[:schema]}`")
    puts("- plan: `#{plan[:plan_id]}`")
    puts("- repo: `#{plan[:repo]}`")
    puts("- role: `#{plan[:repository][:role] || "unknown"}`")
    puts("- head: `#{plan[:head]}`")
    puts("- branch: `#{plan[:branch]}`")
    puts("- host: `#{plan[:host]}`")
    puts("- level: `#{plan[:level]}`")
    puts("- mode: `#{plan[:mode]}`")
    puts("- managed: `#{plan[:managed]}`")
    puts("- greedy: `#{plan[:greedy]}`")
    puts("- platform: `#{plan[:platform]}`")
    puts("- state: `#{plan[:state_path]}`")
    puts("- actions: `#{plan[:actions].length}`")
    puts
    puts("## Core")
    puts
    puts_action_list("Home Entrypoints", plan.fetch(:core).fetch(:home_entrypoints_to_write)) do |entrypoint|
      "`#{entrypoint[:source]}` => `#{entrypoint[:target]}` (#{entrypoint[:strategy]})"
    end

    puts_action_list("Links", plan.fetch(:core).fetch(:links_to_create)) do |link|
      "`#{link[:source]}` -> `#{link[:target]}`"
    end

    puts_action_list("Stale Links", plan.fetch(:core).fetch(:links_to_remove)) do |link|
      "`#{link[:target]}` if still `#{link[:link_value]}`"
    end

    plan[:modules].each do |mod|
      puts("## #{mod[:name]}")
      puts
      if mod[:skipped]
        puts("Skipped: #{mod[:skip_reason]}")
        puts
        next
      end

      puts("Level: #{mod[:level]}")
      puts("Phase: #{mod[:phase]}")
      puts("Virtual: #{mod[:virtual] ? "yes" : "no"}")
      puts
      puts_action_list("Directories", mod[:directories_to_create]) { |dir| "`#{dir[:target]}`" }
      puts_action_list("Links", mod[:links_to_create]) { |link| "`#{link[:source]}` -> `#{link[:target]}`" }
      puts_action_list("Copies", mod[:copies_to_create]) { |copy| "`#{copy[:source]}` -> `#{copy[:target]}`" }
      puts_action_list("Seeds", mod[:seeds_to_create]) { |seed| "`#{seed[:source]}` -> `#{seed[:target]}`" }
      puts_action_list("Resets", mod[:resets_to_create]) { |reset| "`#{reset[:source]}` -> `#{reset[:target]}`" }
      puts_action_list("Install Packages", mod[:packages_to_install]) { |pkg| "`#{pkg[:value]}`" }
      puts_action_list("Refresh Packages", mod[:packages_to_refresh]) { |pkg| "`#{pkg[:value]}`" }
      puts_action_list("Upgrade Packages", mod[:packages_to_upgrade]) { |pkg| "`#{pkg[:value]}`" }
      unless mod[:special_sections].empty?
        puts_action_list("Sections", mod[:special_sections].keys) { |name| "`#{name}`" }
      end
    end

    puts("## Manual Actions")
    puts
    puts_action_list("Actions", manual_actions(plan)) do |action|
      "`#{action[:module_id]}` #{action[:name]} (#{action[:reason]})"
    end
  end

  def puts_action_list(title, items)
    puts("#{title}:")
    items.each { |item| puts("- #{yield(item)}") }
    puts("- none") if items.empty?
    puts
  end

  def manual_actions(plan)
    plan.fetch(:actions).select { |action| action.fetch(:kind) == "manual" }
  end

  def repository_identity
    tilde = tilde_frontmatter(@repo.join("AGENTS.md"))
    {
      protocol: tilde["protocol"],
      role: tilde["role"],
      path: @repo.to_s,
      branch: current_branch,
      commit: @head,
      dirty: dirty?
    }
  end

  def repo_role
    @repo_role ||= tilde_frontmatter(@repo.join("AGENTS.md"))["role"] || "unknown"
  end

  def source_path(dir, source)
    path = (dir + source).cleanpath
    repo = @repo.to_s

    raise "Source escapes repository: #{source}" unless path.to_s == repo || path.to_s.start_with?("#{repo}/")

    path.to_s
  end

  def source_path_at(dir, source)
    path = (@repo + dir + source).cleanpath
    repo = @repo.to_s

    raise "Source escapes repository: #{source}" unless path.to_s == repo || path.to_s.start_with?("#{repo}/")

    path.to_s
  end

  def readme_at(commit, dir)
    git("show", "#{commit}:#{dir}/README.md")
  end

  def stale_link_actions(_modules)
    current = current_link_action_keys

    previous_link_actions.filter_map do |action|
      next if current.include?(link_action_key(action))

      stale_link_action(action)
    end
  end

  def stale_link_action(action)
    {
      id: "#{action.fetch(:id)}:remove",
      kind: "unlink",
      module_id: action.fetch(:module_id),
      module_name: action.fetch(:module_name),
      phase: action.fetch(:phase, "normal"),
      repo_role: action.fetch(:repo_role),
      source: action.fetch(:source),
      target: action.fetch(:target),
      link_value: action.fetch(:link_value),
      conflict: {
        strategy: "none"
      }
    }
  end

  def tree_children_at(commit, path)
    git("ls-tree", "--name-only", "#{commit}:#{path}").lines(chomp: true)
  rescue StandardError
    []
  end

  def suppressed_fan_in_child?(source, target, child)
    source == "skills/" && target == "~/.agents/skills" && child.basename.to_s == "tilde"
  end

  def read_state
    return nil unless state_path.file?

    data = YAML.safe_load(state_path.read, aliases: true, permitted_classes: [Date, Time])
    data.is_a?(Hash) ? data : nil
  rescue Psych::Exception
    nil
  end

  def resolved_level
    return @level if @level

    state_level = @state && @state.dig("applied", "level").to_s
    return state_level if LEVELS.key?(state_level)

    "normal"
  end

  def apply?
    @mode == "apply"
  end

  def refresh?
    @mode == "refresh"
  end

  def repair?
    @mode == "repair"
  end

  def short_hostname
    hostname = `hostname -f 2>/dev/null`.strip
    hostname = `hostname`.strip if hostname.empty?
    hostname.sub(/\..*\z/, "")
  end

  def section_actions(body)
    return {} if align?

    selected_special_sections(body)
  end

  def section_plan_action(mod, name, section, metadata = {})
    bash_only = section.fetch(:bash_only)
    kind = bash_only ? "section" : "manual"

    {
      id: "#{mod.fetch(:id)}:#{kind}:#{name}",
      kind:,
      module_id: mod.fetch(:id),
      module_name: mod.fetch(:name),
      phase: mod.fetch(:phase),
      repo_role: mod.fetch(:repo_role),
      name:,
      bash_only:,
      bash_blocks: section.fetch(:bash_blocks),
      body: section.fetch(:body),
      reason: section_manual_reason(section),
      conflict: {
        strategy: "none"
      }
    }.merge(metadata)
  end

  def section_manual_reason(section)
    return nil if section.fetch(:bash_only)

    return "non-shell-code" if fenced_blocks(section.fetch(:body)).any? { |info, _content| !bash_fence?(info) }

    "no-shell-blocks"
  end

  def section_plan_actions(mod, names, metadata = {})
    names.filter_map do |name|
      section = mod.fetch(:special_sections)[name]
      section_plan_action(mod, name, section, metadata) if section
    end
  end

  def selected_special_sections(body)
    sections = special_sections(body)
    return sections if refresh?

    sections.except("Update")
  end

  def special_sections(body)
    sections = {}
    collected_special_sections(body).each do |section|
      existing = sections[section.fetch(:name)]
      sections[section.fetch(:name)] = merge_section(existing, section.fetch(:content))
    end

    sections
  end

  def collected_special_sections(body)
    markdown_sections(body, 2).flat_map do |section|
      name = special_heading(section.fetch(:title))
      next [{name:, content: section.fetch(:content)}] if name

      platform = platform_heading(section.fetch(:title))
      next [] unless ["all", @platform].include?(platform)

      markdown_sections(section.fetch(:content), 3).filter_map do |subsection|
        subsection_name = special_heading(subsection.fetch(:title))
        next unless subsection_name

        {name: subsection_name, content: subsection.fetch(:content)}
      end
    end
  end

  def markdown_sections(body, level)
    heading = "#" * level
    body.scan(/^#{heading}\s+(.+?)\s*$\n(.*?)(?=^#{heading}\s+|\z)/m).map do |title, content|
      {title: title.strip, content: content.strip}
    end
  end

  def merge_section(existing, content)
    body = [existing&.fetch(:body), content].compact.reject(&:empty?).join("\n\n")
    blocks = bash_blocks(body)

    {
      body:,
      bash_blocks: blocks,
      bash_only: blocks.any? && fenced_blocks(body).all? { |info, _content| bash_fence?(info) }
    }
  end

  def fenced_blocks(body)
    body.scan(/^```([^\n`]*)\n(.*?)^```[ \t]*$/m)
  end

  def platform_scopes(body)
    markdown_sections(body, 2).filter_map do |section|
      platform = platform_heading(section.fetch(:title))
      next unless platform

      {platform:, content: section.fetch(:content)}
    end
  end

  def tilde_frontmatter(path)
    frontmatter, = frontmatter_and_body(path)
    tilde = frontmatter["tilde"] if frontmatter.is_a?(Hash)
    tilde.is_a?(Hash) ? tilde : {}
  end

  def platform_heading(title)
    case title.strip.downcase
    when "all", "all platforms"
      "all"
    when "linux"
      "linux"
    when "macos", "darwin"
      "macos"
    when "windows"
      "windows"
    end
  end

  def special_heading(title)
    SPECIAL_SECTIONS.find { |name| name == title.strip }
  end

  def state_root
    root = ENV.fetch("XDG_STATE_HOME", File.join(Dir.home, ".local", "state"))
    Pathname.new(root).expand_path.join("tilde")
  end

  def state_path
    state_root.join("state.yml")
  end

  def target_identity
    {
      host: @host,
      platform: @platform,
      mode: @mode,
      managed: @managed,
      greedy: @greedy,
      level: @level,
      converges: converges?,
      home: Dir.home,
      state_root: state_root.to_s,
      state_path: state_path.to_s
    }
  end

  def validate_platform!
    return if DEFAULT_PACKAGE_TYPE.key?(@platform)

    raise "Unsupported platform: #{@platform}"
  end

  def validate_level!
    return if LEVELS.key?(@level)

    raise "Unsupported level: #{@level}"
  end

  def validate_mode!
    return if MODES.include?(@mode)

    raise "Unsupported mode: #{@mode}"
  end

  def validate_refresh_options!
    raise "--greedy is only supported with refresh mode" if @greedy && !refresh?
    raise "--managed is only supported with refresh mode" if @managed && !refresh?
  end

  def validate_repo!
    raise "Not a directory: #{@repo}" unless @repo.directory?
  end

  def validate_worktree!
    return if refresh?
    return if @allow_dirty || !dirty?

    raise "Dirty worktree. Commit changes before provisioning, or use --allow-dirty for development only."
  end
end

def main(argv)
  options = {
    allow_dirty: false,
    format: "json",
    greedy: false,
    level: nil,
    managed: false,
    mode: "apply",
    repo: Dir.pwd
  }

  OptionParser
    .new do |parser|
      parser.banner = "Usage: plan [options]"
      parser.on("--allow-dirty", "Allow planning with a dirty worktree") { options[:allow_dirty] = true }
      parser.on("--format FORMAT", "Output format: json or markdown") { |value| options[:format] = value }
      parser.on("--host HOST", "Host short name") { |value| options[:host] = value }
      parser.on("--level LEVEL", "Level: minimal, normal, extra") { |value| options[:level] = value }
      parser.on("--managed", "Refresh managed non-system package declarations in refresh mode") {
        options[:managed] = true
      }
      parser.on("--mode MODE", "Mode: align, apply, refresh, repair") { |value| options[:mode] = value }
      parser.on("--platform PLATFORM", "Platform: linux, macos, windows") { |value| options[:platform] = value }
      parser.on("--repo PATH", "Repository root") { |value| options[:repo] = value }
      parser.on("--greedy", "Add broad package-manager upgrade actions to refresh mode") { options[:greedy] = true }
    end
    .parse!(argv)

  unless %w[json markdown].include?(options[:format])
    warn("Unsupported format: #{options[:format]}")
    return 2
  end

  Plan.new(options).run
  0
rescue StandardError => e
  warn("error: #{e.message}")
  1
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
