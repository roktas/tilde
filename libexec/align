#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

TILDE_ROOT=${TILDE_ROOT:-$(cd -- "${BASH_SOURCE[0]%/*}/.." >/dev/null && pwd)}
readonly TILDE_ROOT

abort() {
	warn "E: $*"
	exit 2
}

warn() {
	printf '%s\n' "$*" >&2
}

# ------------------------------------------------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------------------------------------------------

configured_repo() {
	local key=$1

	command -v ruby >/dev/null || abort "ruby is missing"
	ruby -ryaml -e '
		key = ARGV.fetch(0)
		root = ENV.fetch("XDG_STATE_HOME", File.join(Dir.home, ".local", "state"))
		path = File.join(root, "tilde", "state.yml")
		exit 0 unless File.file?(path)

		data = YAML.safe_load(File.read(path), aliases: true) || {}
		value = data[key] if data.is_a?(Hash)
		puts value if value && !value.to_s.empty?
	' "$key"
}

host_name() {
	local host

	host=$(hostname -f 2>/dev/null || hostname)
	host=${host%%.*}
	printf '%s\n' "$host"
}

usage() {
	cat <<-EOF
		Usage: "\$TILDE" align [--repo PATH] [--public PATH] [--private PATH] [--host HOST] [--level LEVEL] [--allow-dirty] [--dry-run|--plan-only]
	EOF
}

# ------------------------------------------------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------------------------------------------------

main() {
	local allow_dirty=0
	local dry_run=0
	local host
	local level=
	local plan_file
	local private=
	local public=
	local repo
	local tmpdir=
	local -a apply_args=()
	local -a plan_args=()
	local -a plans=()
	local -a repos=()

	host=$(host_name)

	while (($# > 0)); do
		case $1 in
		--help | -h)
			usage
			return
			;;
		--allow-dirty)
			allow_dirty=1
			shift
			;;
		--dry-run | dry-run | --plan-only | plan-only)
			dry_run=1
			shift
			;;
		--host)
			(($# > 1)) || abort "--host needs a value"
			host=$2
			shift 2
			;;
		--host=*)
			host=${1#*=}
			shift
			;;
		--level)
			(($# > 1)) || abort "--level needs a value"
			level=$2
			shift 2
			;;
		--level=*)
			level=${1#*=}
			shift
			;;
		--private)
			(($# > 1)) || abort "--private needs a value"
			private=$2
			shift 2
			;;
		--private=*)
			private=${1#*=}
			shift
			;;
		--public)
			(($# > 1)) || abort "--public needs a value"
			public=$2
			shift 2
			;;
		--public=*)
			public=${1#*=}
			shift
			;;
		--repo)
			(($# > 1)) || abort "--repo needs a value"
			repos+=("$2")
			shift 2
			;;
		--repo=*)
			repos+=("${1#*=}")
			shift
			;;
		ssh:*)
			abort "remote align is agent-orchestrated; use the Tilde skill with prompt: /tilde align $1"
			;;
		*)
			abort "unknown align argument: $1"
			;;
		esac
	done

	if ((${#repos[@]} == 0)); then
		public=${public:-$(configured_repo public)}
		private=${private:-$(configured_repo private)}
		[[ -z $public ]] || repos+=("$public")
		[[ -z $private ]] || repos+=("$private")
	else
		[[ -z $public ]] || repos+=("$public")
		[[ -z $private ]] || repos+=("$private")
	fi

	((${#repos[@]} > 0)) || abort "no Tilde repositories configured; pass --repo, --public, or --private"

	plan_args=(--mode align --host "$host")
	((!allow_dirty)) || plan_args+=(--allow-dirty)
	[[ -z $level ]] || plan_args+=(--level "$level")

	if ((dry_run)); then
		for repo in "${repos[@]}"; do
			"$TILDE_ROOT/bin/tilde" plan --repo "$repo" "${plan_args[@]}" --format markdown
		done
		return
	fi

	tmpdir=$(mktemp -d) || exit
	trap 'rm -rf "'"$tmpdir"'"' EXIT
	trap 'rm -rf "'"$tmpdir"'"; exit 130' HUP INT QUIT TERM

	for repo in "${repos[@]}"; do
		plan_file=$tmpdir/plan-${#plans[@]}.json
		plans+=("$plan_file")
		"$TILDE_ROOT/bin/tilde" plan --repo "$repo" "${plan_args[@]}" --format json >"$plan_file"
	done

	for repo in "${plans[@]}"; do
		apply_args+=(--plan "$repo")
	done

	"$TILDE_ROOT/bin/tilde" apply "${apply_args[@]}"
}

main "$@"
