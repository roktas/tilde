#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "date"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "pathname"
require "rbconfig"
require "socket"
require "tempfile"
require "time"
require "tmpdir"
require "yaml"

class Apply
  APPLY_SCHEMA = "tilde.apply/v1"
  CACHE_SCHEMA = "tilde.cache/v1"
  PLAN_SCHEMA = "tilde.plan/v1"
  RESULT_OK = %w[ok unchanged ignored].freeze
  RESUMABLE_RESULTS = %w[ok unchanged].freeze
  ROLES = %w[public private].freeze
  ROLE_ORDER = {
    "public" => 0,
    "private" => 1
  }.freeze
  SUPPORTED_ACTIONS = %w[entrypoint package section link copy manual].freeze
  SUPPORTED_CONDITIONS = %w[graphical].freeze
  SUPPORTED_CONFLICTS = %w[backup none write-fallback-file].freeze
  SUPPORTED_PACKAGE_TYPES = %w[brew cask deb egg flatpak gem github npm scoop skill].freeze
  ACTION_HANDLERS = {
    "copy" => :execute_copy,
    "entrypoint" => :execute_entrypoint,
    "link" => :execute_link,
    "manual" => :execute_manual,
    "package" => :execute_package,
    "section" => :execute_section
  }.freeze
  PACKAGE_COMMANDS = {
    %w[install brew] => ->(name) { ["brew", "install", name] },
    %w[install cask] => ->(name) { ["brew", "install", "--cask", name] },
    %w[install deb] => ->(name) { ["sudo", "apt-get", "install", "-y", name] },
    %w[install egg] => ->(name) { ["uv", "tool", "install", name] },
    %w[install flatpak] => ->(name) { ["flatpak", "install", "-y", "--user", "flathub", name] },
    %w[install gem] => ->(name) { ["gem", "install", "--user-install", "--no-document", name] },
    %w[install npm] => ->(name) { ["bun", "install", "-g", name] },
    %w[install scoop] => ->(name) { ["scoop", "install", name] },
    %w[refresh brew] => ->(name) { name == "*" ? [%w[brew update], %w[brew upgrade]] : ["brew", "upgrade", name] },
    %w[refresh cask] => ->(name) { ["brew", "upgrade", "--cask", name] },
    %w[refresh deb] => lambda { |name|
      if name == "*"
        [%w[sudo apt-get update], %w[sudo apt-get upgrade -y]]
      else
        %w[sudo apt-get install --only-upgrade -y] + [name]
      end
    },
    %w[refresh egg] => ->(name) { ["uv", "tool", "upgrade", name] },
    %w[refresh flatpak] => ->(name) { ["flatpak", "update", "-y", "--user", name] },
    %w[refresh gem] => ->(name) { ["gem", "update", "--user-install", "--no-document", name] },
    %w[refresh npm] => ->(name) { ["bun", "update", "-g", name] },
    %w[refresh scoop] => ->(name) { name == "*" ? [%w[scoop update], %w[scoop update *]] : ["scoop", "update", name] },
    %w[upgrade brew] => ->(name) { ["brew", "upgrade", name] },
    %w[upgrade cask] => lambda { |name|
      name == "*" ? %w[brew upgrade --cask --greedy] : ["brew", "upgrade", "--cask", name]
    },
    %w[upgrade deb] => lambda { |name|
      if name == "*"
        %w[sudo apt-get full-upgrade -y]
      else
        %w[sudo apt-get install --only-upgrade -y] + [name]
      end
    },
    %w[upgrade egg] => ->(name) { ["uv", "tool", "upgrade", name] },
    %w[upgrade flatpak] => lambda { |name|
      name == "*" ? %w[flatpak update -y --user] : ["flatpak", "update", "-y", "--user", name]
    },
    %w[upgrade gem] => ->(name) { ["gem", "update", "--user-install", "--no-document", name] },
    %w[upgrade npm] => ->(name) { ["bun", "update", "-g", name] },
    %w[upgrade scoop] => ->(name) { name == "*" ? %w[scoop update *] : ["scoop", "update", name] }
  }.freeze
  GITHUB_PLATFORM_RULES = {
    "linux" => {
      positive: /(?:linux|\.deb\z)/,
      negative: /(?:darwin|macos|osx|windows|win32|win64|\.exe\z|\.msi\z)/
    },
    "macos" => {
      positive: /(?:darwin|macos|osx)/,
      negative: /(?:linux|windows|win32|win64|\.deb\z|\.rpm\z|\.exe\z|\.msi\z)/
    },
    "windows" => {
      positive: /(?:windows|win32|win64|\.exe\z|\.msi\z)/,
      negative: /(?:linux|darwin|macos|osx|\.deb\z|\.rpm\z)/
    }
  }.freeze

  def initialize(options)
    @home = Pathname.new(ENV.fetch("HOME", Dir.home)).expand_path
    @plan_paths = options.fetch(:plans).map { |path| Pathname.new(path).expand_path }
    @plans = []
    @started_at = Time.now.iso8601
  end

  def run
    load_plans
    validate!
    prepare_state
    write_last_plan
    apply_actions
    write_state if write_state?
    puts(JSON.pretty_generate(@apply))
  end

  private

  def action_failure?(result)
    !RESULT_OK.include?(result.fetch(:status)) && result.fetch(:status) != "deferred"
  end

  def action_result(action, status, diagnostics = {}, backups = [])
    {
      action_id: action.fetch("id"),
      kind: action.fetch("kind"),
      module_id: action.fetch("module_id"),
      status:,
      diagnostics: diagnostics.compact,
      backups:,
      finished_at: Time.now.iso8601
    }
  end

  def actions
    @actions ||= @plans.flat_map { |plan| plan.fetch("actions") }
  end

  def apply_actions
    failed_modules = {}

    actions.each do |action|
      break unless process_action(action, failed_modules)
    end

    @apply[:completed] = !stop_after_reached? && @apply[:results].length == actions.length
    write_last_apply
  end

  def backup_path(target)
    relative = target.relative_path_from(@home).to_s
    ensure_backup_dir.join(relative)
  end

  def backup_target(target)
    backup = backup_path(target)
    FileUtils.mkdir_p(backup.dirname)
    FileUtils.mv(target.to_s, backup.to_s)
    backup.to_s
  end

  def canonicalize(value)
    case value
    when Array
      value.map { |item| canonicalize(item) }
    when Hash
      value.keys.map(&:to_s).sort.to_h do |key|
        [key, canonicalize(value[key])]
      end
    else
      value
    end
  end

  def commands_for(action)
    package = action.fetch("package")
    name = package.fetch("name")
    command = PACKAGE_COMMANDS[[action.fetch("operation"), package.fetch("type")]]

    commands = command&.call(name)
    return unless commands

    commands.first.is_a?(Array) ? commands : [commands]
  end

  def command_available?(name)
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
      path = File.join(dir, name)
      File.file?(path) && File.executable?(path)
    end
  end

  def condition_met?(condition)
    case condition
    when nil
      true
    when "graphical"
      graphical?
    else
      false
    end
  end

  def copy_equal?(source, target)
    return false unless target.exist?

    if source.file? && target.file?
      FileUtils.compare_file(source.to_s, target.to_s)
    elsif source.directory? && target.directory?
      _stdout, _stderr, status = Open3.capture3("diff", "-qr", source.to_s, target.to_s)
      status.success?
    else
      false
    end
  end

  def copy_source(source, target)
    if source.directory?
      FileUtils.mkdir_p(target)
      source.children.each { |child| FileUtils.cp_r(child.to_s, target.join(child.basename).to_s) }
    else
      FileUtils.cp(source.to_s, target.to_s)
    end
  end

  def current_plan_hash(plan)
    content = canonicalize(plan.except("generated_at", "plan_id"))
    "sha256:#{Digest::SHA256.hexdigest(JSON.generate(content))}"
  end

  def detect_platform
    host_os = RbConfig::CONFIG.fetch("host_os")

    case host_os
    when /darwin/i
      "macos"
    when /linux/i
      "linux"
    when /mswin|mingw|cygwin/i
      "windows"
    else
      "unknown"
    end
  end

  def dirty?(repo)
    !git(repo, "status", "--porcelain").empty?
  end

  def ensure_backup_dir
    return @backup_dir if @backup_dir

    @backup_dir = @host_dir.join("backups", Time.now.utc.strftime("%Y%m%dT%H%M%SZ"))
    @backup_dir
  end

  def execute(action)
    send(ACTION_HANDLERS.fetch(action.fetch("kind")), action)
  rescue StandardError => e
    action_result(action, "notok", { "error" => e.message })
  end

  def execute_copy(action)
    source = Pathname.new(action.fetch("source_path"))
    target = expand_target(action.fetch("target"))
    return action_result(action, "unchanged") if copy_equal?(source, target)

    backups = []
    backups << backup_target(target) if target.exist? || target.symlink?
    FileUtils.mkdir_p(target.dirname)

    temp = Pathname.new("#{target}.tilde-tmp-#{$PROCESS_ID}")
    FileUtils.rm_rf(temp)
    copy_source(source, temp)
    FileUtils.mv(temp.to_s, target.to_s)
    action_result(action, "ok", {}, backups)
  ensure
    FileUtils.rm_rf(temp) if temp
  end

  def execute_entrypoint(action)
    source = Pathname.new(action.fetch("source_path"))
    target = expand_target(action.fetch("target"))
    return action_result(action, "unchanged") if target.file? && target.read == source.read

    backups = []
    backups << backup_target(target) if target.exist? || target.symlink?
    FileUtils.mkdir_p(target.dirname)
    target.write(source.read)
    action_result(action, "ok", {}, backups)
  end

  def execute_link(action)
    target = expand_target(action.fetch("target"))
    value = action.fetch("link_value")
    return action_result(action, "unchanged") if target.symlink? && File.readlink(target.to_s) == value

    backups = []
    backups << backup_target(target) if target.exist? || target.symlink?
    FileUtils.mkdir_p(target.dirname)
    File.symlink(value, target.to_s)
    action_result(action, "ok", {}, backups)
  end

  def execute_manual(action)
    action_result(
      action,
      "deferred",
      {
        "reason" => action["reason"],
        "body" => action["body"]
      }
    )
  end

  def execute_package(action)
    package = action.fetch("package")
    type = package.fetch("type")
    unless SUPPORTED_PACKAGE_TYPES.include?(type)
      return action_result(action, "deferred", { "reason" => "unsupported package handler: #{type}" })
    end

    condition = action["condition"] || package["condition"]
    unless condition_met?(condition)
      return action_result(action, "ignored", { "reason" => "condition not met: #{condition}" })
    end

    return execute_github(action) if type == "github"
    return execute_skill(action) if type == "skill"

    commands = commands_for(action)
    return action_result(action, "deferred", { "reason" => "unsupported package operation" }) unless commands

    execute_commands(action, commands)
  end

  def execute_commands(action, commands, diagnostics = {})
    runs = []
    commands.each do |command|
      stdout, stderr, status = Open3.capture3(*command)
      run = { "command" => command, "stdout" => stdout, "stderr" => stderr, "exit" => status.exitstatus }
      return action_result(action, "notok", diagnostics.merge("commands" => runs + [run])) unless status.success?

      runs << run
    end

    action_result(action, "ok", diagnostics.merge("commands" => runs))
  end

  def execute_github(action)
    repo = action.fetch("package").fetch("name")
    unless repo.match?(%r{\A[^/]+/[^/]+\z})
      return action_result(action, "notok", { "reason" => "github package must be owner/repo: #{repo}" })
    end
    return action_result(action, "notok", { "reason" => "missing gh command" }) unless command_available?("gh")

    release = github_release(repo)
    return action_result(action, "notok", release.fetch(:diagnostics)) unless release.fetch(:ok)

    asset = github_asset(release.fetch(:assets))
    return action_result(action, "notok", asset.fetch(:diagnostics)) unless asset.fetch(:ok)

    Dir.mktmpdir("tilde-github-") do |dir|
      download = github_download(repo, asset.fetch(:name), dir)
      return action_result(action, "notok", download.fetch(:diagnostics)) unless download.fetch(:ok)

      install_github_asset(action, repo, release.fetch(:tag), asset.fetch(:name), download.fetch(:path))
    end
  end

  def execute_skill(action)
    source = action.fetch("package").fetch("name")
    target = skill_target(source)
    return action_result(action, "notok", { "reason" => "unsupported skill source: #{source}" }) unless target

    FileUtils.mkdir_p(target.dirname)
    if target.exist?
      unless target.join(".git").directory?
        return action_result(action, "notok", { "reason" => "skill target is not a git checkout: #{target}" })
      end

      status = git_capture(target, "status", "--porcelain")
      return action_result(action, "notok", status.fetch(:diagnostics)) unless status.fetch(:ok)
      unless status.fetch(:stdout).strip.empty?
        return action_result(action, "notok", { "reason" => "skill target is dirty: #{target}" })
      end

      upstream = skill_upstream(target)
      return action_result(action, "notok", upstream.fetch(:diagnostics)) unless upstream.fetch(:ok)

      execute_commands(
        action,
        [
          ["git", "-C", target.to_s, "fetch", "--prune"],
          ["git", "-C", target.to_s, "merge", "--ff-only", upstream.fetch(:ref)]
        ],
        { "target" => target.to_s }
      )
    else
      execute_commands(action, [["git", "clone", skill_url(source), target.to_s]], { "target" => target.to_s })
    end
  end

  def execute_section(action)
    unless action.fetch("bash_only")
      return action_result(action, "deferred", { "reason" => "section is not bash-only" })
    end

    blocks = []
    action.fetch("bash_blocks").each_with_index do |block, index|
      stdout, stderr, status = run_block(block)
      blocks << { "index" => index + 1, "stdout" => stdout, "stderr" => stderr, "exit" => status.exitstatus }
      return action_result(action, "notok", { "blocks" => blocks }) unless status.success?
    end

    action_result(action, "ok", { "blocks" => blocks })
  end

  def expand_target(path)
    text = path.to_s
    return @home if text == "~"
    return @home.join(text.delete_prefix("~/")).expand_path if text.start_with?("~/")

    Pathname.new(text).expand_path
  end

  def git(repo, *args)
    stdout, stderr, status = Open3.capture3("git", "-C", repo.to_s, *args)
    raise stderr.strip unless status.success?

    stdout.strip
  end

  def git_capture(repo, *args)
    stdout, stderr, status = Open3.capture3("git", "-C", repo.to_s, *args)
    {
      ok: status.success?,
      stdout:,
      diagnostics: {
        "command" => ["git", "-C", repo.to_s, *args],
        "stdout" => stdout,
        "stderr" => stderr,
        "exit" => status.exitstatus
      }
    }
  end

  def github_asset(assets)
    ranked = ranked_github_assets(assets)
    return { ok: false, diagnostics: { "reason" => "no matching github release asset" } } if ranked.empty?

    ambiguous = ambiguous_github_assets(ranked)
    if ambiguous.any?
      return { ok: false, diagnostics: { "reason" => "ambiguous github release asset", "assets" => ambiguous } }
    end

    { ok: true, name: ranked.first.last }
  end

  def ranked_github_assets(assets)
    ranked = assets.filter_map do |asset|
      name = asset["name"].to_s
      score = github_asset_score(name)
      [score, name] if score.positive?
    end

    ranked.sort_by { |score, name| [-score, name] }
  end

  def ambiguous_github_assets(ranked)
    return [] if ranked.length < 2

    best_score = ranked.first.first
    return [] unless ranked[1].first == best_score

    ranked.select { |score, _name| score == best_score }.map(&:last)
  end

  def github_asset_score(name)
    text = name.downcase
    return 0 if text.match?(/(?:sha256|checksums?|sbom|signature|\.sig|\.asc|\.pem|\.txt)\z/)
    return 0 if text.match?(/(?:source|src)[-_]?(?:code)?/)

    score = 0
    score += github_platform_score(text)
    score += github_arch_score(text)
    score += 40 if detect_platform == "linux" && text.end_with?(".deb")
    score += 10 if text.match?(/\.(?:tar\.gz|tgz|zip|gz|deb)\z/)
    score
  end

  def github_arch_score(text)
    arch = RbConfig::CONFIG.fetch("host_cpu").downcase
    aliases =
      case arch
      when /x86_64|amd64/
        %w[x86_64 amd64 x64]
      when /aarch64|arm64/
        %w[aarch64 arm64]
      else
        [arch]
      end

    return 20 if aliases.any? { |name| text.include?(name) }
    return 5 if text.match?(/(?:universal|all)/)
    return 3 unless text.match?(/(?:x86_64|amd64|x64|aarch64|arm64|armv?7)/)

    0
  end

  def github_platform_score(text)
    rules = GITHUB_PLATFORM_RULES[detect_platform]
    return 0 unless rules
    return 20 if text.match?(rules.fetch(:positive))
    return 0 if text.match?(rules.fetch(:negative))

    3
  end

  def github_download(repo, asset, dir)
    command = ["gh", "release", "download", "--repo", repo, "--pattern", asset, "--dir", dir, "--clobber"]
    stdout, stderr, status = Open3.capture3(*command)
    path = Pathname.glob(Pathname.new(dir).join("*")).find(&:file?)
    ok = status.success? && path
    {
      ok:,
      path:,
      diagnostics: {
        "command" => command,
        "stdout" => stdout,
        "stderr" => stderr,
        "exit" => status.exitstatus
      }.merge(ok ? {} : { "reason" => "github release download failed" })
    }
  end

  def github_release(repo)
    command = ["gh", "release", "view", "--repo", repo, "--json", "tagName,assets"]
    stdout, stderr, status = Open3.capture3(*command)
    diagnostics = { "command" => command, "stdout" => stdout, "stderr" => stderr, "exit" => status.exitstatus }
    unless status.success?
      return { ok: false, diagnostics: diagnostics.merge("reason" => "github release metadata failed") }
    end

    data = JSON.parse(stdout)
    { ok: true, tag: data["tagName"], assets: Array(data["assets"]) }
  rescue JSON::ParserError => e
    { ok: false, diagnostics: diagnostics.merge("reason" => "invalid github release metadata", "error" => e.message) }
  end

  def install_github_asset(action, repo, tag, asset, path)
    diagnostics = { "repo" => repo, "tag" => tag, "asset" => asset, "path" => path.to_s }
    if path.basename.to_s.downcase.end_with?(".deb")
      return execute_commands(action, [["sudo", "apt-get", "install", "-y", path.to_s]], diagnostics)
    end

    executable = github_executable(path)
    unless executable
      return action_result(action, "notok", diagnostics.merge("reason" => "no unambiguous executable in github asset"))
    end

    target = @home.join(".local", "bin", executable.basename.to_s.sub(/\.exe\z/i, ""))
    FileUtils.mkdir_p(target.dirname)
    FileUtils.cp(executable.to_s, target.to_s)
    FileUtils.chmod(0o755, target.to_s)
    action_result(action, "ok", diagnostics.merge("target" => target.to_s))
  end

  def github_executable(path)
    return path if github_direct_executable?(path)
    return nil unless github_archive?(path)

    Dir.mktmpdir("tilde-github-extract-") do |dir|
      extracted = Pathname.new(dir)
      return nil unless github_extract(path, extracted)

      copy_github_executable(path, github_candidate(path, extracted))
    end
  end

  def github_direct_executable?(path)
    return false unless path.file?

    name = path.basename.to_s.downcase
    return false if github_archive?(path)
    return false if name.match?(/\.(?:rpm|dmg|pkg|msi|gz|xz|bz2|sha256|sig|asc|pem|txt|json|ya?ml)\z/)

    true
  end

  def github_archive?(path)
    path.basename.to_s.downcase.match?(/\.(?:tar\.gz|tgz|tar|zip)\z/)
  end

  def github_candidate(path, extracted)
    candidates = github_candidates(extracted)
    preferred = candidates.select { |candidate| candidate.basename.to_s == path.basename.to_s.sub(/\..*\z/, "") }
    return preferred.first if preferred.length == 1
    return candidates.first if candidates.length == 1

    nil
  end

  def github_candidates(extracted)
    files = extracted.glob("**/*").select(&:file?)
    executables = files.select(&:executable?)
    executables.empty? ? files : executables
  end

  def copy_github_executable(path, selected)
    return nil unless selected

    copy = Pathname.new(path.dirname).join(selected.basename)
    FileUtils.cp(selected.to_s, copy.to_s)
    FileUtils.chmod(0o755, copy.to_s)
    copy
  end

  def github_extract(path, dir)
    name = path.basename.to_s.downcase
    command =
      if name.match?(/\.(?:tar\.gz|tgz|tar)\z/)
        ["tar", "-xf", path.to_s, "-C", dir.to_s]
      elsif name.end_with?(".zip")
        ["unzip", "-q", path.to_s, "-d", dir.to_s]
      else
        return false
      end

    _stdout, _stderr, status = Open3.capture3(*command)
    status.success?
  end

  def graphical?
    case detect_platform
    when "macos"
      true
    when "linux"
      stdout, _stderr, status = Open3.capture3("systemctl", "get-default")
      status.success? && stdout.strip == "graphical.target"
    else
      false
    end
  end

  def host
    Socket.gethostname.split(".").first
  end

  def init_apply
    {
      schema: APPLY_SCHEMA,
      started_at: @started_at,
      completed: false,
      input_id:,
      plans: @plans.map { |plan| plan_metadata(plan) },
      results: []
    }
  end

  def load_plans
    raise "at least one --plan is required" if @plan_paths.empty?

    @plans = @plan_paths.map { |path| JSON.parse(path.read) }
    @plans.sort_by! { |plan| ROLE_ORDER.fetch(plan.fetch("repository").fetch("role"), 99) }
  rescue JSON::ParserError => e
    raise "invalid plan JSON: #{e.message}"
  end

  def module_results
    results = skipped_module_results
    module_statuses.each do |module_id, values|
      results[module_id] = values.all? { |value| RESULT_OK.include?(value) } ? "ok" : "notok"
    end
    results
  end

  def module_statuses
    statuses = actions.to_h { |action| [action.fetch("module_id"), []] }
    @apply.fetch(:results).each do |result|
      statuses[result.fetch(:module_id)] ||= []
      statuses[result.fetch(:module_id)] << result.fetch(:status)
    end

    statuses
  end

  def modules
    @modules ||= @plans.flat_map { |plan| plan.fetch("modules", []) }
  end

  def path_inside?(path, root)
    path = path.expand_path
    root = root.expand_path
    path.to_s == root.to_s || path.to_s.start_with?("#{root}/")
  end

  def plan_metadata(plan)
    repository = plan.fetch("repository")
    {
      plan_id: plan.fetch("plan_id"),
      role: repository.fetch("role"),
      path: repository.fetch("path"),
      commit: repository.fetch("commit"),
      dirty: repository.fetch("dirty")
    }
  end

  def input_id
    @input_id ||= begin
      ids = @plans.map { |plan| plan.fetch("plan_id") }
      "sha256:#{Digest::SHA256.hexdigest(JSON.generate(ids))}"
    end
  end

  def prepare_state
    target = @plans.first.fetch("target")
    @state_root = Pathname.new(target.fetch("state_root")).expand_path
    @host_dir = @state_root.join("hosts", target.fetch("host"))
    @last_apply_path = @host_dir.join("last-apply.json")
    @last_plan_path = @host_dir.join("last-plan.json")
    @state_path = @host_dir.join("state.md")
    FileUtils.mkdir_p(@host_dir)
    @resume = read_resume
    @apply = init_apply
  end

  def process_action(action, failed_modules)
    result = result_for(action, failed_modules)
    record(result)
    failed_modules[action.fetch("module_id")] = true if module_failure?(action, result)
    !core_failure?(action, result) && !stop_after_reached?
  end

  def read_resume
    return nil unless @last_apply_path&.file?

    data = JSON.parse(@last_apply_path.read)
    return nil if data["completed"]
    return nil unless data["input_id"] == input_id

    data
  rescue JSON::ParserError
    nil
  end

  def previous_done
    return @previous_done if defined?(@previous_done)

    @previous_done = read_state_done
  end

  def previous_bootstrap
    return @previous_bootstrap if defined?(@previous_bootstrap)

    @previous_bootstrap = read_state_frontmatter.fetch("bootstrap", nil)
  end

  def previous_module_status(mod)
    previous_done[mod.fetch("id")] || previous_done[mod.fetch("name")]
  end

  def read_state_done
    done = read_state_frontmatter["done"]
    done.is_a?(Hash) ? done : {}
  end

  def read_state_frontmatter
    return {} unless @state_path.file?

    text = @state_path.read
    return {} unless text.start_with?("---\n")

    _head, yaml, _body = text.split(/^---\s*$\n?/, 3)
    YAML.safe_load(yaml, aliases: true, permitted_classes: [Date, Time]) || {}
  rescue Psych::SyntaxError
    {}
  end

  def skill_name(source)
    value = source.to_s.sub(/\.git\z/, "").split("/").last
    value.empty? ? nil : value
  end

  def skill_target(source)
    name = skill_name(source)
    return nil unless name

    @home.join(".agents", "skills", name)
  end

  def skill_upstream(target)
    upstream = git_capture(target, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if upstream.fetch(:ok)
      return { ok: true, ref: upstream.fetch(:stdout).strip, diagnostics: upstream.fetch(:diagnostics) }
    end

    origin = git_capture(target, "symbolic-ref", "refs/remotes/origin/HEAD", "--short")
    return { ok: true, ref: origin.fetch(:stdout).strip, diagnostics: origin.fetch(:diagnostics) } if origin.fetch(:ok)

    { ok: false, diagnostics: upstream.fetch(:diagnostics).merge("reason" => "skill checkout has no upstream") }
  end

  def skill_url(source)
    text = source.to_s
    return "https://#{text}.git" if text.match?(%r{\Agithub\.com/[^/]+/[^/]+/?\z})
    return "https://github.com/#{text}.git" if text.match?(%r{\A[^/]+/[^/]+\z})

    text
  end

  def record(result)
    @apply.fetch(:results) << result
    write_last_apply
  end

  def resume_result(action)
    return nil unless @resume

    result = @resume.fetch("results", []).find { |item| item.fetch("action_id") == action.fetch("id") }
    return nil unless result && RESUMABLE_RESULTS.include?(result.fetch("status"))

    {
      action_id: result.fetch("action_id"),
      kind: result.fetch("kind"),
      module_id: result.fetch("module_id"),
      status: result.fetch("status"),
      diagnostics: result.fetch("diagnostics", {}).merge("resumed" => true),
      backups: result.fetch("backups", []),
      finished_at: Time.now.iso8601
    }
  end

  def core_failure?(action, result)
    action.fetch("module_id") == "core" && action_failure?(result)
  end

  def module_failure?(action, result)
    action.fetch("module_id") != "core" && action_failure?(result)
  end

  def result_for(action, failed_modules)
    if failed_modules.key?(action.fetch("module_id"))
      action_result(action, "ignored", { "reason" => "previous module action failed" })
    else
      resume_result(action) || execute(action)
    end
  end

  def run_block(block)
    file = Tempfile.new(["tilde-section", ".sh"])
    file.write(block)
    file.close
    Open3.capture3("bash", file.path)
  ensure
    file&.close!
  end

  def stop_after_reached?
    stop = ENV.fetch("TILDE_APPLY_STOP_AFTER", nil)
    stop && @apply.fetch(:results).length >= stop.to_i
  end

  def target
    @target ||= @plans.first.fetch("target")
  end

  def write_state?
    %w[apply repair].include?(target.fetch("mode"))
  end

  def validate!
    validate_plans!
    validate_repositories!
    validate_actions!
  end

  def validate_action!(action, seen)
    validate_action_id!(action, seen)
    validate_action_kind!(action)
    validate_condition!(action)
    validate_conflict!(action)
    validate_target!(action["target"]) if action.key?("target")
    validate_source!(action) if action.key?("source_path")
    validate_package!(action) if action.fetch("kind") == "package"
    validate_section!(action) if action.fetch("kind") == "section"
  end

  def validate_action_id!(action, seen)
    id = action.fetch("id")
    raise "duplicate action id: #{id}" if seen.key?(id)

    seen[id] = true
  end

  def validate_action_kind!(action)
    kind = action.fetch("kind")
    raise "unsupported action kind: #{kind}" unless SUPPORTED_ACTIONS.include?(kind)
  end

  def validate_actions!
    seen = {}
    actions.each { |action| validate_action!(action, seen) }
  end

  def validate_conflict!(action)
    strategy = action.fetch("conflict", {}).fetch("strategy", "none")
    raise "unsupported conflict strategy: #{strategy}" unless SUPPORTED_CONFLICTS.include?(strategy)
  end

  def validate_condition!(action)
    package = action["package"]
    conditions = [action["condition"]]
    conditions << package["condition"] if package.is_a?(Hash)
    conditions = conditions.compact.uniq
    return if conditions.empty?

    raise "conflicting conditions: #{conditions.join(', ')}" if conditions.length > 1

    condition = conditions.first
    raise "unsupported condition: #{condition}" unless SUPPORTED_CONDITIONS.include?(condition)
  end

  def validate_package!(action)
    package = action.fetch("package")
    type = package.fetch("type")
    raise "unsupported package type: #{type}" unless (SUPPORTED_PACKAGE_TYPES + %w[github skill]).include?(type)
    raise "missing package name" if package.fetch("name").to_s.empty?
  end

  def validate_plan!(plan)
    raise "unsupported plan schema: #{plan['schema']}" unless plan["schema"] == PLAN_SCHEMA
    raise "missing plan id" unless plan["plan_id"].to_s.start_with?("sha256:")
    raise "plan id mismatch" unless plan.fetch("plan_id") == current_plan_hash(plan)
    raise "target home mismatch" unless Pathname.new(plan.fetch("target").fetch("home")).expand_path == @home
    raise "target host mismatch" unless plan.fetch("target").fetch("host") == host
    raise "target platform mismatch" unless plan.fetch("target").fetch("platform") == detect_platform
  end

  def validate_plans!
    roles = {}
    first_target = @plans.first&.fetch("target")
    raise "at least one plan is required" unless first_target

    @plans.each do |plan|
      validate_plan!(plan)
      validate_role!(plan, roles)
      validate_target_match!(plan, first_target)
    end

    validate_host_dir!(first_target)
  end

  def validate_host_dir!(first_target)
    state_root = Pathname.new(first_target.fetch("state_root")).expand_path
    raise "state root must exist: #{state_root}" unless state_root.directory?
    raise "state root is not writable: #{state_root}" unless state_root.writable?
  end

  def validate_repositories!
    @plans.each do |plan|
      repo = Pathname.new(plan.fetch("repository").fetch("path")).expand_path
      raise "repository is not a directory: #{repo}" unless repo.directory?
      raise "repository commit mismatch: #{repo}" unless repository_commit_matches?(repo, plan)
      raise "repository dirty state mismatch: #{repo}" unless dirty?(repo) == plan.fetch("repository").fetch("dirty")
    end
  end

  def repository_commit_matches?(repo, plan)
    git(repo, "rev-parse", "HEAD") == plan.fetch("repository").fetch("commit")
  end

  def validate_role!(plan, roles)
    role = plan.fetch("repository").fetch("role")
    raise "unsupported repository role: #{role}" unless ROLES.include?(role)
    raise "duplicate repository role: #{role}" if roles.key?(role)

    roles[role] = true
  end

  def validate_section!(action)
    raise "section action must be bash-only" unless action.fetch("bash_only")
    raise "section action must include bash blocks" if action.fetch("bash_blocks").empty?
  end

  def validate_source!(action)
    source = Pathname.new(action.fetch("source_path")).expand_path
    raise "source is not readable: #{source}" unless source.readable?
    return if action.fetch("module_id") == "core"

    repo = repository_for(action.fetch("repo_role"))
    raise "source escapes repository: #{source}" unless path_inside?(source, repo)
  end

  def validate_target!(target)
    path = expand_target(target)
    raise "target escapes home: #{target}" unless path_inside?(path, @home)
  end

  def validate_target_match!(plan, first_target)
    %w[host platform mode scope level home state_root].each do |key|
      raise "plan target #{key} mismatch" unless plan.fetch("target").fetch(key) == first_target.fetch(key)
    end
  end

  def repository_for(role)
    plan = @plans.find { |item| item.fetch("repository").fetch("role") == role }
    raise "unknown repository role: #{role}" unless plan

    Pathname.new(plan.fetch("repository").fetch("path")).expand_path
  end

  def write_json(path, data)
    FileUtils.mkdir_p(path.dirname)
    temp = path.dirname.join(".#{path.basename}.tmp-#{$PROCESS_ID}")
    temp.write(JSON.pretty_generate(data))
    FileUtils.mv(temp.to_s, path.to_s)
  ensure
    FileUtils.rm_f(temp) if temp&.exist?
  end

  def write_last_apply
    write_json(@last_apply_path, @apply)
  end

  def write_last_plan
    modules = @plans.flat_map { |plan| plan.fetch("modules", []) }
    core_entrypoints = @plans.flat_map { |plan| plan.fetch("core").fetch("home_entrypoints_to_write", []) }
    links = @plans.flat_map { |plan| plan.fetch("core").fetch("links_to_create", []) }
    cache = {
      schema: CACHE_SCHEMA,
      generated_at: Time.now.iso8601,
      input_id:,
      plans: @plans,
      core: {
        "home_entrypoints_to_write" => core_entrypoints,
        "links_to_create" => links
      },
      modules:,
      actions:
    }

    write_json(@last_plan_path, cache)
  end

  def write_state
    temp = @state_path.dirname.join(".#{@state_path.basename}.tmp-#{$PROCESS_ID}")
    temp.write(state_text)
    FileUtils.mv(temp.to_s, @state_path.to_s)
  ensure
    FileUtils.rm_f(temp) if temp&.exist?
  end

  def state_body
    @apply
      .fetch(:results)
      .reject { |result| RESULT_OK.include?(result.fetch(:status)) }
      .map { |result| "- #{result.fetch(:module_id)} #{result.fetch(:action_id)}: #{result.fetch(:status)}" }
      .join("\n")
  end

  def state_frontmatter
    frontmatter = {
      "host" => target.fetch("host"),
      "date" => Time.now.iso8601,
      "bootstrap" => previous_bootstrap,
      "public" => role_repository("public"),
      "private" => role_repository("private"),
      "done" => module_results
    }.compact
    frontmatter["head"] = frontmatter.dig("public", "commit") if frontmatter["public"]
    frontmatter
  end

  def state_text
    text = +"---\n"
    text << YAML.dump(state_frontmatter).delete_prefix("---\n")
    text << "---\n"
    text << state_body
    text << "\n" unless text.end_with?("\n")
    text
  end

  def role_repository(role)
    @plans.find { |plan| plan.fetch("repository").fetch("role") == role }&.fetch("repository")
  end

  def skipped_module_results
    modules.filter_map do |mod|
      next unless mod["skipped"]

      status = previous_module_status(mod)
      [mod.fetch("id"), status] if status
    end.to_h
  end
end

def main(argv)
  options = {
    plans: []
  }

  OptionParser
    .new do |parser|
      parser.banner = "Usage: apply --plan PLAN.json [--plan PLAN.json ...]"
      parser.on("--plan PLAN", "Plan JSON to apply") { |value| options.fetch(:plans) << value }
    end
    .parse!(argv)

  Apply.new(options).run
  0
rescue StandardError => e
  warn("error: #{e.message}")
  1
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
