#!/usr/bin/env bash

set -Eeuo pipefail
[[ -z ${TRACE:-} ]] || set -x
unset CDPATH

if [[ ${TILDE_SUDO:-} != intercept ]]; then
	printf '%s\n' "E: Tilde sudo shim is only available inside the Tilde execution environment" >&2
	exit 125
fi

root=$(cd -- "${BASH_SOURCE[0]%/*}/.." >/dev/null && pwd)
exec "$root/bin/tilde" sudo -- "$@"
