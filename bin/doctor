#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "date"
require "open3"
require "optparse"
require "pathname"
require "socket"
require "time"
require "yaml"

class Doctor
  def initialize(options)
    @format = options.fetch(:format)
    @home = Pathname.new(ENV.fetch("HOME", Dir.home)).expand_path
    @host = options[:host] || Socket.gethostname.split(".").first
    @state_dir = expand(options[:state_dir] || "~/.local/state/tilde")
  end

  def run
    report = collect
    @format == "markdown" ? puts_markdown(report) : puts(JSON.pretty_generate(report))
  end

  private

  def area(path)
    names = path.relative_path_from(dropbox).each_filename.map(&:downcase)
    return "cache" if names.intersect?(%w[.cache cache caches .dropbox.cache])
    return "archive" if names.intersect?(%w[archive archives arsiv])
    return "tmp" if names.intersect?(%w[.tmp tmp temp temporary])

    "active"
  end

  def collect
    plan = read_plan
    findings = health_findings(plan) + repository_findings + action_findings(plan)
    {
      schema: "tilde.doctor/v1",
      generated_at: Time.now.iso8601,
      host: @host,
      state_dir: show(@state_dir),
      config: show(config_path),
      host_state: show(host_state_path),
      last_plan: show(plan_path),
      findings:
    }
  end

  def action_findings(plan)
    plan.fetch("actions", []).filter_map { |action| inspect_action(action) }
  end

  def config_path
    @state_dir.join("config.yml")
  end

  def display_target(target, path)
    target.start_with?("~/") ? target : show(path)
  end

  def expand(path)
    text = path.to_s
    return @home if text == "~"
    return @home.join(text.delete_prefix("~/")).expand_path if text.start_with?("~/")

    Pathname.new(text).expand_path
  end

  def finding(action, path, link, problems)
    {
      kind: "link",
      area: area(path),
      module_id: action["module_id"],
      action_id: action["id"],
      target: display_target(action.fetch("target"), path),
      link:,
      problems:
    }
  end

  def git(repo, *args)
    stdout, stderr, status = Open3.capture3("git", "-C", repo.to_s, *args)
    {
      ok: status.success?,
      stdout:,
      stderr:,
      exit: status.exitstatus
    }
  end

  def health_findings(plan)
    findings = []
    findings << issue("state", config_path, ["missing config"]) unless config_path.file?
    findings << issue("state", host_state_path, ["missing host state"]) unless host_state_path.file?
    findings << issue("cache", plan_path, ["missing cached plan"]) unless plan_path.file?
    findings << issue("cache", plan_path, ["invalid cached plan: #{plan.fetch('error')}"]) if plan["error"]
    findings
  end

  def host_state_path
    @state_dir.join("hosts", @host, "state.md")
  end

  def host_absolute?(link)
    link == @home.to_s || link.start_with?("#{@home}/")
  end

  def inspect_action(action)
    return nil unless link_action?(action)

    path = expand(action.fetch("target"))
    return nil unless managed_dropbox_link?(path)

    link = File.readlink(path.to_s)
    problems = problems(path, link)
    return nil if problems.empty?

    finding(action, path, link, problems)
  rescue SystemCallError => e
    finding(action, path, nil, ["error: #{e.message}"])
  end

  def inside?(path, root)
    path = path.expand_path
    root = root.expand_path
    path.to_s == root.to_s || path.to_s.start_with?("#{root}/")
  end

  def issue(kind, path, problems)
    {
      kind:,
      area: "active",
      target: show(path),
      problems:
    }
  end

  def link_action?(action)
    action["kind"] == "link" && action["target"]
  end

  def managed_dropbox_link?(path)
    inside?(path, dropbox) && path.symlink?
  end

  def plan_path
    @plan_path ||= @state_dir.join("hosts", @host, "last-plan.json")
  end

  def read_plan
    JSON.parse(plan_path.read)
  rescue Errno::ENOENT
    { "actions" => [] }
  rescue JSON::ParserError => e
    { "actions" => [], "error" => e.message }
  end

  def read_state
    return {} unless host_state_path.file?

    text = host_state_path.read
    return {} unless text.start_with?("---\n")

    _head, yaml, _body = text.split(/^---\s*$\n?/, 3)
    YAML.safe_load(yaml, aliases: true, permitted_classes: [Date, Time]) || {}
  rescue Psych::SyntaxError
    {}
  end

  def read_yaml(path)
    return {} unless path.file?

    YAML.safe_load(path.read, aliases: true, permitted_classes: [Date, Time]) || {}
  rescue Psych::SyntaxError
    {}
  end

  def repository_findings
    repositories = {}
    config = read_yaml(config_path)
    state = read_state
    repositories["public"] = config["public"] || state.dig("public", "path")
    repositories["private"] = config["private"] || state.dig("private", "path")

    repositories.filter_map do |label, value|
      repository_finding(label, expand(value)) if value
    end
  end

  def repository_finding(label, path)
    return issue("repository", path, ["#{label} repository missing"]) unless path.directory?
    return issue("repository", path, ["#{label} repository is not a git checkout"]) unless path.join(".git").exist?

    status = git(path, "status", "--porcelain")
    unless status.fetch(:ok)
      return issue("repository", path, ["#{label} repository git error: #{status.fetch(:stderr).strip}"])
    end
    return issue("repository", path, ["#{label} repository dirty"]) unless status.fetch(:stdout).strip.empty?

    nil
  end

  def problems(path, link)
    problems = []
    problems << "broken" unless resolved?(path)
    problems << "host-absolute" if host_absolute?(link)
    problems
  end

  def resolved?(path)
    path.realpath
    true
  rescue Errno::ENOENT
    false
  end

  def dropbox
    @dropbox ||= @home.join("Dropbox").expand_path
  end

  def show(path)
    path = Pathname.new(path.to_s)
    text = path.to_s
    text == @home.to_s ? "~" : text.sub(%r{\A#{Regexp.escape(@home.to_s)}/}, "~/")
  end

  def puts_markdown(report)
    puts("# Tilde Doctor")
    puts
    puts("- Host: `#{report.fetch(:host)}`")
    puts("- State root: `#{report.fetch(:state_dir)}`")
    puts("- Last plan cache: `#{report.fetch(:last_plan)}`")
    puts
    puts_health(report)
    puts
    puts_dropbox_links(report)
  end

  def puts_health(report)
    health = health_items(report)
    puts("## Health")
    if health.empty?
      puts("- No deployment state, cache, or repository health problems found.")
    else
      health.each do |item|
        puts("- `#{item.fetch(:target)}`: #{item.fetch(:problems).join(', ')}")
      end
    end
  end

  def puts_dropbox_links(report)
    puts("## Dropbox Links")
    findings = link_items(report)
    if findings.empty?
      puts("- No broken or host-absolute managed Dropbox links found.")
    else
      findings.each do |item|
        puts(
          "- `#{item.fetch(:target)}`: #{item.fetch(:problems).join(', ')} " \
          "(`#{item.fetch(:area)}`, `#{item.fetch(:module_id)}`)"
        )
      end
    end
  end

  def health_items(report)
    report.fetch(:findings).reject { |item| item.fetch(:kind) == "link" }
  end

  def link_items(report)
    report.fetch(:findings).select { |item| item.fetch(:kind) == "link" }
  end
end

def main(argv)
  options = {
    format: "markdown"
  }

  OptionParser
    .new do |parser|
      parser.banner = "Usage: doctor [options]"
      parser.on("--format FORMAT", "Output format: json or markdown") { |value| options[:format] = value }
      parser.on("--host HOST", "Host short name") { |value| options[:host] = value }
      parser.on("--state-dir PATH", "Tilde state directory") { |value| options[:state_dir] = value }
    end
    .parse!(argv)

  unless %w[json markdown].include?(options[:format])
    warn("Unsupported format: #{options[:format]}")
    return 2
  end

  Doctor.new(options).run
  0
rescue StandardError => e
  warn("error: #{e.message}")
  1
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
