#!/usr/bin/env ruby
# frozen_string_literal: true

require "date"
require "json"
require "open3"
require "optparse"
require "pathname"
require "socket"
require "time"
require "yaml"

class Status
  SKILL_ROOT = Pathname.new(__dir__).parent.expand_path.freeze

  def initialize(options)
    @format = options.fetch(:format)
    @home = Pathname.new(ENV.fetch("HOME", Dir.home)).expand_path
    @host = options[:host] || Socket.gethostname.split(".").first
    @state_dir = expand_home(options[:state_dir] || "~/.local/state/tilde")
    @public = options[:public]
    @private = options[:private]
  end

  def run
    status = collect
    @format == "markdown" ? puts_markdown(status) : puts(JSON.pretty_generate(status))
  end

  private

  def action_count(modules, key)
    modules.sum { |mod| Array(mod[key]).length }
  end

  def cache_surface(path)
    return {present: false, path: display_path(path)} unless path.file?

    cached_plan_summary(path, JSON.parse(path.read))
  rescue JSON::ParserError => e
    {present: true, path: display_path(path), error: e.message}
  end

  def cached_plan_summary(path, data)
    modules = Array(data["modules"])
    {
      present: true,
      path: display_path(path),
      generated_at: data["generated_at"],
      repo: data["repo"],
      head: data["head"],
      module_count: modules.length,
      links: Array(data.dig("core", "links_to_create")).length + action_count(modules, "links_to_create"),
      home_entrypoints: Array(data.dig("core", "home_entrypoints_to_write")).length,
      copies: action_count(modules, "copies_to_create"),
      install_packages: action_count(modules, "packages_to_install"),
      refresh_packages: action_count(modules, "packages_to_refresh"),
      upgrade_packages: action_count(modules, "packages_to_upgrade")
    }
  end

  def collect
    config_path = @state_dir.join("config.yml")
    host_state_path = @state_dir.join("hosts", @host, "state.md")
    config = read_yaml(config_path)
    state_frontmatter, state_body = read_frontmatter(host_state_path)

    status = {
      generated_at: Time.now.iso8601,
      host: @host,
      state_dir: display_path(@state_dir),
      config: config_summary(config_path, config),
      host_state: host_state_summary(host_state_path, state_frontmatter, state_body),
      caches: cache_summary,
      repositories: repository_summary(config),
      home_entrypoint: home_entrypoint_status
    }
    status[:warnings] = warnings(status)
    status
  end

  def cache_summary
    host_dir = @state_dir.join("hosts", @host)
    {
      last_plan: cache_surface(host_dir.join("last-plan.json")),
      last_apply: cache_surface(host_dir.join("last-apply.json"))
    }
  end

  def config_summary(path, config)
    return {present: false, path: display_path(path)} unless path.file?
    return {present: true, path: display_path(path), error: config.fetch("_error")} if config_error?(config)

    {
      present: true,
      path: display_path(path),
      protocol: config["protocol"],
      skill: config["skill"],
      public: config["public"],
      private: config["private"]
    }
  end

  def config_error?(config)
    config.is_a?(Hash) && config.key?("_error")
  end

  def configured_path(option, configured)
    value = option || configured
    value ? expand_home(value) : nil
  end

  def display_path(path)
    path = Pathname.new(path.to_s)
    home = @home.to_s
    text = path.to_s
    text == home ? "~" : text.sub(%r{\A#{Regexp.escape(home)}/}, "~/")
  end

  def expand_home(path)
    text = path.to_s
    return @home if text == "~"
    return @home.join(text.delete_prefix("~/")).expand_path if text.start_with?("~/")

    Pathname.new(text).expand_path
  end

  def git(repo, *)
    stdout, stderr, status = Open3.capture3("git", "-C", repo.to_s, *)
    raise stderr.strip unless status.success?

    stdout.strip
  end

  def host_state_summary(path, frontmatter, body)
    return {present: false, path: display_path(path)} unless path.file?
    return {present: true, path: display_path(path), error: frontmatter.fetch("_error")} if frontmatter.key?("_error")

    done = frontmatter.fetch("done", {}) || {}
    {
      present: true,
      path: display_path(path),
      host: frontmatter["host"],
      date: frontmatter["date"]&.to_s,
      head: frontmatter["head"],
      public: frontmatter["public"],
      private: frontmatter["private"],
      done_count: done.length,
      done:,
      body: body.to_s.strip
    }
  end

  def link_line(link)
    return "missing" unless link[:exists]

    text = link[:type] || "present"
    text += " -> `#{link[:target]}`" if link[:target]
    text += ", #{link[:entrypoint]}" if link[:entrypoint]
    text += ", legacy skill-template symlink" if link[:legacy_skill_symlink]
    text
  end

  def link_summary(path)
    path = expand_home(path)
    exists = path.exist? || path.symlink?
    summary = {path: display_path(path), exists:}
    return summary unless exists

    stat = path.lstat
    summary[:type] = link_type(stat)
    if stat.symlink?
      target = File.readlink(path)
      resolved = realpath_or_nil(path)
      summary[:target] = target.start_with?("/") ? display_path(target) : target
      summary[:resolved] = display_path(resolved) if resolved
    end

    summary
  rescue Errno::ENOENT
    {path: display_path(path), exists: false}
  rescue SystemCallError => e
    {path: display_path(path), exists:, error: e.message}
  end

  def link_type(stat)
    return "symlink" if stat.symlink?
    return "directory" if stat.directory?

    "file"
  end

  def partial?(status)
    !status.dig(:config, :present) ||
      !status.dig(:host_state, :present) ||
      !status.dig(:caches, :last_plan, :present)
  end

  def presence_line(present, path)
    present ? "present at `#{path}`" : "missing at `#{path}`"
  end

  def puts_deployment(status)
    host_state = status.fetch(:host_state)
    plan_cache = presence_line(status.dig(:caches, :last_plan, :present), status.dig(:caches, :last_plan, :path))
    apply_cache = presence_line(status.dig(:caches, :last_apply, :present), status.dig(:caches, :last_apply, :path))

    puts("## Deployment")
    puts("- Config: #{presence_line(status.dig(:config, :present), status.dig(:config, :path))}")
    puts("- Host state: #{presence_line(host_state[:present], host_state[:path])}")
    puts("- Last apply date: `#{host_state[:date] || "unknown"}`") if host_state[:present]
    puts("- Recorded modules: `#{host_state[:done_count]}`") if host_state[:present]
    puts("- Last plan cache: #{plan_cache}")
    puts("- Last apply cache: #{apply_cache}")
    puts
  end

  def puts_header(status)
    puts("# Tilde Status")
    puts
    puts("- Host: `#{status.fetch(:host)}`")
    puts("- State root: `#{status.fetch(:state_dir)}`")
    puts
  end

  def puts_managed_surface(status)
    last_plan = status.dig(:caches, :last_plan)

    puts("## Managed Surface")
    if last_plan[:present] && !last_plan[:error]
      puts("- Cached modules: `#{last_plan[:module_count]}`")
      puts("- Cached home entrypoints: `#{last_plan[:home_entrypoints] || 0}`")
      puts("- Cached links: `#{last_plan[:links]}`")
      puts("- Cached copies: `#{last_plan[:copies]}`")
      puts("- Cached install packages: `#{last_plan[:install_packages]}`")
    else
      puts("- Cached surface unavailable. Fast status did not inspect module README files or live link targets.")
    end

    puts
  end

  def puts_markdown(status)
    puts_header(status)
    puts_deployment(status)
    puts_repositories(status)
    puts_home(status)
    puts_managed_surface(status)
    puts_warnings(status)
  end

  def puts_repositories(status)
    puts("## Repositories")
    status.fetch(:repositories).each_value do |repo|
      puts("- #{repo.fetch(:label)}: #{repo_line(repo)}")
    end

    puts
  end

  def puts_home(status)
    puts("## Home Entrypoint")
    status.fetch(:home_entrypoint).each do |name, link|
      puts("- `#{name}`: #{link_line(link)}")
    end

    puts
  end

  def puts_warnings(status)
    return if status.fetch(:warnings).empty?

    puts("## Warnings")
    status.fetch(:warnings).each { |warning| puts("- #{warning}") }
  end

  def read_frontmatter(path)
    return [{}, nil] unless path.file?

    text = path.read
    return [{}, text] unless text.start_with?("---\n")

    _, yaml_text, body = text.split(/^---\s*$\n?/, 3)
    [YAML.safe_load(yaml_text, aliases: true, permitted_classes: [Date, Time]) || {}, body]
  rescue Psych::SyntaxError => e
    [{"_error" => e.message}, nil]
  end

  def read_yaml(path)
    return nil unless path.file?

    YAML.safe_load(path.read, aliases: true, permitted_classes: [Date, Time]) || {}
  rescue Psych::SyntaxError => e
    {"_error" => e.message}
  end

  def realpath_or_nil(path)
    path.realpath.to_s
  rescue Errno::ENOENT
    nil
  end

  def repo_line(repo)
    problem = repo_problem(repo)
    return problem if problem

    branch = repo[:branch] || "unknown branch"
    dirty = repo[:dirty] ? "dirty" : "clean"
    "`#{repo[:path]}` `#{branch}` `#{repo[:head] || "unknown"}`, #{dirty}"
  end

  def repo_problem(repo)
    return "not configured" unless repo[:path]
    return "missing at `#{repo[:path]}`" unless repo[:exists]
    return "not a git repo at `#{repo[:path]}`" unless repo[:git]
    return "`#{repo[:path]}` git error: #{repo[:error]}" if repo[:error]

    nil
  end

  def repo_summary(label, path)
    return {label:, path: nil, exists: false, git: false} unless path

    summary = {
      label:,
      path: display_path(path),
      exists: path.directory?,
      git: path.join(".git").exist?
    }
    return summary unless summary[:exists] && summary[:git]

    status = git(path, "status", "--short", "--branch")
    summary.merge(
      branch: status.lines.first&.strip&.delete_prefix("## "),
      dirty: status.lines.drop(1).any?,
      head: git(path, "rev-parse", "--short", "HEAD")
    )
  rescue StandardError => e
    summary.merge(error: e.message)
  end

  def repository_summary(config)
    {
      public: repo_summary("public", configured_path(@public, config && config["public"])),
      private: repo_summary("private", configured_path(@private, config && config["private"]))
    }
  end

  def home_entrypoint_status
    {
      "~/AGENTS.md" => home_entrypoint_summary("~/AGENTS.md"),
      "~/.agents" => link_summary("~/.agents"),
      "~/.agents/skills/tilde" => link_summary("~/.agents/skills/tilde"),
      "skill root" => {
        path: display_path(SKILL_ROOT),
        exists: SKILL_ROOT.directory?,
        type: "directory"
      }
    }
  end

  def home_entrypoint_summary(path)
    path = expand_home(path)
    summary = link_summary(path.to_s)
    return summary unless summary[:exists]

    frontmatter, = read_frontmatter(path)
    tilde = frontmatter["tilde"] if frontmatter.is_a?(Hash)
    if tilde.is_a?(Hash) && tilde["source"] == "~/.agents/skills/tilde/assets/AGENTS.md"
      summary[:entrypoint] = "fallback home-entrypoint"
      summary[:source] = tilde["source"]
    elsif tilde.is_a?(Hash) && tilde["protocol"] == "tilde/v1"
      summary[:entrypoint] = "data-repository home-entrypoint"
    end

    summary[:legacy_skill_symlink] = legacy_skill_symlink?(path)
    summary
  end

  def legacy_skill_symlink?(path)
    path.symlink? && realpath_or_nil(path) == SKILL_ROOT.join("assets/AGENTS.md").to_s
  end

  def warnings(status)
    warnings = []
    unless status.dig(:config, :present)
      warnings << "No local Tilde config was found; repository bindings are limited to explicit options."
    end

    warnings << "No host deployment state was found for `#{@host}`." unless status.dig(:host_state, :present)
    unless status.dig(:caches, :last_plan, :present)
      warnings <<
        "No cached plan was found; managed-surface counts require explicit " \
          "`$tilde status discover` or `$tilde doctor`."
    end

    if partial?(status)
      warnings <<
        "Fast status is partial and did not regenerate plans, validate live links, " \
          "query packages, call Dropbox, or scan home."
    end

    if status.dig(:home_entrypoint, "~/AGENTS.md", :legacy_skill_symlink)
      warnings <<
        "`~/AGENTS.md` points at the fallback skill template; deploy should replace it with a data-repository home entrypoint link."
    end

    warnings
  end
end

def main(argv)
  options = {
    format: "markdown"
  }

  OptionParser
    .new do |parser|
      parser.banner = "Usage: status [options]"
      parser.on("--format FORMAT", "Output format: json or markdown") { |value| options[:format] = value }
      parser.on("--host HOST", "Host short name") { |value| options[:host] = value }
      parser.on("--private PATH", "Private home repository path") { |value| options[:private] = value }
      parser.on("--public PATH", "Public home repository path") { |value| options[:public] = value }
      parser.on("--state-dir PATH", "Tilde state directory") { |value| options[:state_dir] = value }
    end
    .parse!(argv)

  unless %w[json markdown].include?(options[:format])
    warn("Unsupported format: #{options[:format]}")
    return 2
  end

  Status.new(options).run
  0
rescue StandardError => e
  warn("error: #{e.message}")
  1
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
